---
interface Props { titulo: string; sinMenu?: boolean }
const { titulo, sinMenu = false } = Astro.props;
const ruta = Astro.url.pathname;
const { user, inst, instituciones } = Astro.locals;
const menu = [
  ['/', 'Inicio'],
  ['/secciones', 'Secciones'],
  ['/estudiantes', 'Estudiantes'],
  ['/asistencia', 'Asistencia'],
  ['/evaluaciones', 'Evaluaciones'],
  ['/notas', 'Calificaciones'],
  ['/anual', 'Nota anual'],
  ['/alertas', 'Alerta temprana'],
  ['/indicadores', 'Indicadores'],
  ['/componentes', 'Componentes'],
  ['/periodos', 'Periodos'],
  ['/ajustes', 'Ajustes'],
  ['/respaldo', 'Respaldo'],
];
const admin = [['/admin/usuarios', 'Usuarios'], ['/admin/instituciones', 'Instituciones']];
const activo = (h: string) => (h === '/' ? ruta === '/' : ruta.startsWith(h));
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" />
  <title>{titulo} · ReDDi Web</title>
  <style is:global>
    :root {
      --tinta: #1d2a2f; --suave: #5b6b70; --linea: #d9e1e0; --papel: #f6f8f7; --blanco: #fff;
      --verde: #1f6f5c; --verde-claro: #e3f1ec; --rojo: #b3402f; --rojo-claro: #fbe9e5; --ambar: #a86b00; --ambar-claro: #fff3d6;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: var(--tinta); background: var(--papel);
    }
    * { box-sizing: border-box; }
    body { margin: 0; }
    a { color: var(--verde); }
    .app { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
    nav.lateral { background: var(--tinta); color: #cfdcd9; padding: 18px 12px; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
    nav.lateral .marca { font-weight: 700; color: #fff; font-size: 17px; margin: 0 8px 18px; line-height: 1.2; }
    nav.lateral .marca small { display: block; font-weight: 400; color: #8fa6a1; font-size: 12px; }
    nav.lateral a { display: block; color: #cfdcd9; text-decoration: none; padding: 8px 10px; border-radius: 6px; font-size: 14px; }
    nav.lateral a:hover { background: #2c3c42; }
    nav.lateral a.on { background: var(--verde); color: #fff; }
    nav.lateral form button { margin: 16px 8px 0; background: none; border: 1px solid #45575d; color: #cfdcd9; width: calc(100% - 16px); }
    nav.lateral .grupo { margin: 14px 10px 4px; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #8fa6a1; }
    nav.lateral select { width: calc(100% - 16px); margin: 0 8px 12px; background: #2c3c42; color: #fff; border-color: #45575d; font-size: 13px; }
    nav.lateral .quien { margin: 0 8px 14px; font-size: 12px; color: #8fa6a1; }
    nav.lateral .quien a { display: inline; padding: 0; color: #cfdcd9; text-decoration: underline; }
    main { padding: 24px 28px 60px; max-width: 1400px; }
    h1 { font-size: 24px; margin: 0 0 4px; }
    .sub { color: var(--suave); margin: 0 0 20px; font-size: 14px; }
    h2 { font-size: 17px; margin: 28px 0 10px; }
    .tarjeta { background: var(--blanco); border: 1px solid var(--linea); border-radius: 10px; padding: 16px 18px; margin-bottom: 16px; }
    .fila { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
    label { display: flex; flex-direction: column; font-size: 12px; color: var(--suave); gap: 4px; }
    input, select, textarea { font: inherit; font-size: 14px; padding: 7px 9px; border: 1px solid #b9c6c4; border-radius: 6px; background: #fff; color: var(--tinta); }
    textarea { min-height: 70px; }
    button, .btn { font: inherit; font-size: 14px; padding: 7px 14px; border-radius: 6px; border: 1px solid var(--verde); background: var(--verde); color: #fff; cursor: pointer; text-decoration: none; display: inline-block; }
    button.sec, .btn.sec { background: #fff; color: var(--verde); }
    button.peligro { background: #fff; color: var(--rojo); border-color: var(--rojo); }
    button.mini { padding: 3px 8px; font-size: 12px; }
    table { border-collapse: collapse; width: 100%; background: #fff; font-size: 14px; }
    th, td { border-bottom: 1px solid var(--linea); padding: 7px 8px; text-align: left; vertical-align: middle; }
    th { background: #eef3f2; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; color: var(--suave); position: sticky; top: 0; }
    td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
    td input { padding: 4px 6px; width: 100%; min-width: 60px; }
    .tabla { overflow-x: auto; border: 1px solid var(--linea); border-radius: 10px; }
    .chip { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 12px; font-weight: 600; }
    .ok { background: var(--verde-claro); color: var(--verde); }
    .mal { background: var(--rojo-claro); color: var(--rojo); }
    .aviso { background: var(--ambar-claro); color: var(--ambar); }
    .msg { padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; font-size: 14px; }
    .grid-kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
    .kpi { background: #fff; border: 1px solid var(--linea); border-radius: 10px; padding: 14px 16px; }
    .kpi b { display: block; font-size: 26px; }
    .kpi span { color: var(--suave); font-size: 13px; }
    .muted { color: var(--suave); font-size: 13px; }
    .solo-print { display: none; }
    @media (max-width: 800px) {
      .app { grid-template-columns: 1fr; }
      nav.lateral { position: static; height: auto; display: flex; flex-wrap: wrap; gap: 4px; }
      nav.lateral .marca { width: 100%; }
      main { padding: 16px; }
    }
    @media print {
      nav.lateral, .no-print, button, .btn { display: none !important; }
      .app { display: block; } main { padding: 0; max-width: none; }
      .tarjeta, .tabla { border: none; } .solo-print { display: block; }
      th { position: static; }
    }
  </style>
</head>
<body>
  {sinMenu ? <slot /> : (
    <div class="app">
      <nav class="lateral">
        <div class="marca">ReDDi Web<small>Registro docente</small></div>
        <div class="quien">{user?.nombre} · <a href="/cuenta">Mi cuenta</a></div>
        {instituciones?.length > 1 ? (
          <form method="get" action="/cambiar-institucion" style="margin:0">
            <input type="hidden" name="volver" value={ruta} />
            <select name="id" onchange="this.form.submit()" aria-label="Institución activa">
              {instituciones.map((i) => <option value={i.id} selected={i.id === inst?.id}>{i.nombre}</option>)}
            </select>
          </form>
        ) : inst && <div class="quien" style="color:#fff">{inst.nombre}</div>}
        {menu.map(([h, t]) => <a href={h} class={activo(h) ? 'on' : ''}>{t}</a>)}
        {user?.rol === 'admin' && <div class="grupo">Administración</div>}
        {user?.rol === 'admin' && admin.map(([h, t]) => <a href={h} class={activo(h) ? 'on' : ''}>{t}</a>)}
        <form method="post" action="/login?salir=1"><button type="submit">Salir</button></form>
      </nav>
      <main><slot /></main>
    </div>
  )}
</body>
</html>
