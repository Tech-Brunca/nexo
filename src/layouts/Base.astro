---
interface Props { titulo: string; sinMenu?: boolean }
const { titulo, sinMenu = false } = Astro.props;
const ruta = Astro.url.pathname;
import { logoColegio } from '../lib/auth';
const { user, inst, instituciones, periodos = [], periodo = null } = Astro.locals;
// Menú agrupado por lo que el docente va a hacer. Cada grupo se pliega; el de la página actual queda abierto.
// Íconos propios (trazo de 1,8 px, 24×24) que heredan el color del texto.
const ICONOS: Record<string, string> = {
  inicio: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5.5h4V20"/>',
  aula: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20l2.5-4M16 20l-2.5-4M7 9h6M7 12h9"/>',
  grupos: '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19c.6-3 2.8-4.8 5.5-4.8s4.9 1.8 5.5 4.8"/><circle cx="16.5" cy="9.5" r="2.4"/><path d="M15.5 14.4c2.6-.3 4.5 1.3 5 4.1"/>',
  resultados: '<path d="M4 20h16"/><rect x="5.5" y="11" width="3" height="6.5" rx=".6"/><rect x="10.5" y="7" width="3" height="10.5" rx=".6"/><rect x="15.5" y="13" width="3" height="4.5" rx=".6"/>',
  familias: '<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h0A2.5 2.5 0 0 1 4 13.5Z"/><path d="M8.5 9.5h7M8.5 12.5h4.5"/>',
  config: '<path d="M4 7h8M16 7h4M4 12h2M10 12h10M4 17h10M18 17h2"/><circle cx="14" cy="7" r="2"/><circle cx="8" cy="12" r="2"/><circle cx="16" cy="17" r="2"/>',
  admin: '<path d="M12 3.5 5 6.5v5c0 4.3 3 7.6 7 9 4-1.4 7-4.7 7-9v-5Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
};
type Grupo = { clave: string; titulo: string; abierto?: boolean; items: [string, string][] };
const grupos: Grupo[] = [
  { clave: 'aula', titulo: 'En el aula', abierto: true, items: [['/bitacora', 'Bitácora'], ['/plan', 'Plan anual'], ['/asistencia', 'Asistencia'], ['/evaluaciones', 'Evaluaciones'], ['/notas', 'Calificaciones']] },
  { clave: 'grupos', titulo: 'Grupos', items: [['/secciones', 'Secciones'], ['/estudiantes', 'Estudiantes']] },
  { clave: 'resultados', titulo: 'Resultados', items: [['/anual', 'Nota anual'], ['/informes', 'Informes'], ['/sea', 'Importar / exportar SEA']] },
  { clave: 'familias', titulo: 'Familias', items: [['/comunicados', 'Comunicados'], ['/comunicados#un-estudiante', 'A un estudiante'], ['/alertas', 'Alerta temprana']] },
];
const config: Grupo = { clave: 'config', titulo: 'Configuración', items: [
  ['/indicadores', 'Indicadores'], ['/componentes', 'Componentes'], ['/periodos', 'Periodos'],
  ['/plantillas', 'Mensajes WhatsApp'], ['/ajustes', 'Ajustes'], ['/respaldo', 'Respaldo'],
] };
const admin: Grupo = { clave: 'admin', titulo: 'Administración', items: [['/admin/usuarios', 'Usuarios'], ['/admin/colegios', 'Colegios'], ['/admin/componentes-mep', 'Componentes del MEP']] };
const menuGrupos = [...(inst ? grupos : []), config, ...(user?.rol === 'admin' ? [admin] : [])];
const activo = (h: string) => (h === '/' ? ruta === '/' : ruta.startsWith(h));
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0A3D91" />
  <link rel="icon" href="/favicon.svg" />
  <title>{titulo} · Nexo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      /* Paleta de marca Nexo */
      --marino: #0A3D91; --marino-osc: #072B6A; --teal: #0C7C90; --cian: #12CFF3; --aqua: #49E1FF;
      --hielo: #EAF8FC; --gris: #F4F7FA;
      /* Uso */
      --tinta: #13233f; --suave: #5a6b82; --linea: #dde6ef; --papel: var(--gris); --blanco: #fff;
      --verde: #137a52; --verde-claro: #e2f5ec; --rojo: #b3402f; --rojo-claro: #fbe9e5; --ambar: #a86b00; --ambar-claro: #fff3d6;
      --titulos: 'Montserrat', 'Segoe UI', system-ui, sans-serif;
      --texto: 'Atkinson Hyperlegible Next', 'Atkinson Hyperlegible', 'Segoe UI', system-ui, sans-serif;
      font-family: var(--texto); font-size: 15px; line-height: 1.45; color: var(--tinta); background: var(--papel);
    }
    * { box-sizing: border-box; }
    body { margin: 0; }
    a { color: var(--teal); }
    a:hover { color: var(--marino); }
    .app { display: grid; grid-template-columns: 232px 1fr; min-height: 100vh; }

    /* Menú lateral */
    nav.lateral { background: linear-gradient(180deg, var(--marino) 0%, var(--marino-osc) 100%); color: #cfe0f5; padding: 18px 12px; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
    .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .marca img { width: 40px; height: 40px; flex: none; }
    .marca b { font-family: var(--titulos); font-weight: 800; font-size: 22px; letter-spacing: .02em; line-height: 1; }
    .marca b span { color: var(--cian); }
    .marca small { display: block; font-size: 11px; font-weight: 400; margin-top: 3px; letter-spacing: .01em; }
    nav.lateral a.marca { display: flex; margin: 0 6px 18px; padding: 0; border: 0; }
    nav.lateral .marca:hover { background: none; }
    nav.lateral .marca b { color: #fff; }
    nav.lateral .marca b span { color: var(--aqua); }
    nav.lateral .marca small { color: #a9c4e6; }
    nav.lateral a { display: block; color: #d4e4f7; text-decoration: none; padding: 8px 10px; border-radius: 8px; font-size: 14px; border-left: 3px solid transparent; }
    nav.lateral a:hover { background: rgba(255,255,255,.08); color: #fff; }
    nav.lateral a.on { background: rgba(18,207,243,.16); color: #fff; border-left-color: var(--cian); font-weight: 600; }
    nav.lateral form button { margin: 16px 8px 0; background: transparent; border: 1px solid rgba(255,255,255,.28); color: #d4e4f7; width: calc(100% - 16px); font-weight: 400; }
    nav.lateral form button:hover { background: rgba(255,255,255,.08); }
    nav.lateral .ico { width: 19px; height: 19px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    nav.lateral a.ir-inicio { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    nav.lateral .gmenu { margin-top: 2px; }
    nav.lateral .gmenu summary { list-style: none; display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 8px; cursor: pointer;
      color: #b9d2f0; font-weight: 600; font-size: 14px; user-select: none; -webkit-tap-highlight-color: transparent; }
    nav.lateral .gmenu summary::-webkit-details-marker { display: none; }
    nav.lateral .gmenu summary:hover { background: rgba(255,255,255,.08); color: #fff; }
    nav.lateral .gmenu summary:focus-visible { outline: 3px solid rgba(18,207,243,.55); outline-offset: -2px; }
    nav.lateral .gmenu summary span { flex: 1; }
    nav.lateral .gmenu .flecha { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: .7; transition: transform .15s ease; }
    nav.lateral .gmenu[open] .flecha { transform: rotate(90deg); }
    nav.lateral .gmenu[data-aqui="1"] > summary { color: #fff; }
    nav.lateral .gmenu .items { margin: 2px 0 6px; padding-left: 19px; border-left: 1px solid rgba(255,255,255,.12); margin-left: 19px; }
    nav.lateral .gmenu .items a { padding: 7px 10px; }
    nav.lateral select { width: calc(100% - 16px); margin: 0 8px 12px; background: rgba(255,255,255,.08); color: #fff; border-color: rgba(255,255,255,.2); font-size: 13px; }
    nav.lateral .quien { margin: 0 8px 14px; font-size: 12px; color: #a9c4e6; }
    nav.lateral .quien a { display: inline; padding: 0; border: 0; color: #fff; text-decoration: underline; }
    nav.lateral .colegio { display: flex; align-items: center; gap: 10px; margin: 0 6px 12px; padding: 10px 12px; border-radius: 10px; background: rgba(255,255,255,.08); border: 1px solid rgba(73,225,255,.25); color: #fff; font-size: 13px; font-weight: 600; }
    nav.lateral .colegio .escudo { width: 38px; height: 38px; object-fit: contain; flex: none; background: #fff; border-radius: 8px; padding: 3px; }
    nav.lateral .colegio a { padding: 4px 0 0; border: 0; font-weight: 400; color: var(--aqua); font-size: 12px; }
    nav.lateral .periodo-trabajo { display: flex; flex-direction: column; gap: 4px; margin: -4px 6px 14px; color: #a9c4e6; font-size: 12.5px; }
    nav.lateral .periodo-trabajo select { width: 100%; margin: 0; font-weight: 600; font-size: 15px; background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(73,225,255,.35); }
    nav.lateral .periodo-trabajo select option { color: var(--tinta); }
    nav.lateral .colegio a:hover { background: none; text-decoration: underline; }

    /* Contenido */
    main { padding: 26px 30px 60px; max-width: 1400px; }
    h1, h2 { font-family: var(--titulos); color: var(--marino); }
    h1 { font-size: 24px; font-weight: 700; margin: 0 0 4px; }
    .sub { color: var(--suave); margin: 0 0 20px; font-size: 14px; }
    h2 { font-size: 17px; font-weight: 700; margin: 28px 0 10px; }
    .tarjeta { background: var(--blanco); border: 1px solid var(--linea); border-radius: 12px; padding: 16px 18px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(10,61,145,.04); }
    .fila { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
    label { display: flex; flex-direction: column; font-size: 12px; color: var(--suave); gap: 4px; }
    input, select, textarea { font: inherit; font-size: 14px; padding: 7px 9px; border: 1px solid #c6d4e3; border-radius: 8px; background: #fff; color: var(--tinta); }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--cian); box-shadow: 0 0 0 3px rgba(18,207,243,.22); }
    textarea { min-height: 70px; }
    button, .btn { font: inherit; font-size: 14px; font-weight: 600; padding: 7px 14px; border-radius: 8px; border: 1px solid var(--marino); background: var(--marino); color: #fff; cursor: pointer; text-decoration: none; display: inline-block; transition: background .15s, border-color .15s; }
    button:hover, .btn:hover { background: var(--marino-osc); border-color: var(--marino-osc); color: #fff; }
    button:disabled, .btn[aria-disabled="true"] { opacity: .5; cursor: not-allowed; }
    button.sec, .btn.sec { background: #fff; color: var(--marino); border-color: #c6d4e3; }
    button.sec:hover, .btn.sec:hover { background: var(--hielo); border-color: var(--cian); }
    button.peligro { background: #fff; color: var(--rojo); border-color: var(--rojo); }
    button.peligro:hover { background: var(--rojo-claro); }
    button.mini { padding: 3px 8px; font-size: 12px; }
    button:focus-visible, .btn:focus-visible, a:focus-visible { outline: 3px solid rgba(18,207,243,.5); outline-offset: 2px; }
    table { border-collapse: collapse; width: 100%; background: #fff; font-size: 14px; }
    th, td { border-bottom: 1px solid var(--linea); padding: 7px 8px; text-align: left; vertical-align: middle; }
    th { background: var(--hielo); font-size: 13px; font-weight: 600; color: #3d5a73; position: sticky; top: 0; }
    tr:hover td { background: #f8fcfe; }
    td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
    table { font-variant-numeric: tabular-nums; }
    td input { padding: 4px 6px; width: 100%; min-width: 60px; }
    td input[type=checkbox], td input[type=radio] { width: auto; min-width: 0; }
    .tabla { overflow-x: auto; border: 1px solid var(--linea); border-radius: 12px; }
    .chip { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 12px; font-weight: 600; }
    .ok { background: var(--verde-claro); color: var(--verde); }
    .mal { background: var(--rojo-claro); color: var(--rojo); }
    .aviso { background: var(--ambar-claro); color: var(--ambar); }
    .msg { padding: 10px 14px; border-radius: 10px; margin-bottom: 14px; font-size: 14px; }
    .grid-kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
    .kpi { background: #fff; border: 1px solid var(--linea); border-top: 3px solid var(--cian); border-radius: 12px; padding: 14px 16px; }
    .kpi b { display: block; font-family: var(--titulos); font-size: 26px; color: var(--marino); }
    .kpi span { color: var(--suave); font-size: 13px; }
    .inicio { min-height: calc(100vh - 84px); }
    .marca-agua-inicio { display: block; width: min(57vw, 495px); max-height: 360px; margin: 4px auto 18px; object-fit: contain; opacity: .22; filter: saturate(.8) blur(.3px); pointer-events: none; user-select: none; }
    .muted { color: var(--suave); font-size: 13px; }
    .solo-print { display: none; }

    /* Pantallas de ingreso */
    .acceso { min-height: 100vh; display: flex; align-items: center; padding: 24px 6vw; background: #071f4d url('/fondo-acceso.webp') center right / cover no-repeat; }
    .acceso-tarjeta { width: min(420px, 100%); padding: 30px 30px 24px !important; border: 0 !important; border-radius: 16px !important; box-shadow: 0 20px 50px rgba(3,18,48,.45); }
    .acceso-tarjeta .marca { flex-direction: column; text-align: center; gap: 8px; margin-bottom: 18px; }
    .acceso-tarjeta .marca img { width: 76px; height: 76px; }
    .acceso-tarjeta .marca b { color: var(--marino); font-size: 34px; }
    .acceso-tarjeta .marca small { color: var(--suave); font-size: 13px; }
    .acceso-tarjeta h1 { font-size: 20px; text-align: center; }
    .acceso-tarjeta .sub { text-align: center; }
    .acceso-tarjeta button { padding: 10px 14px; font-size: 15px; }

    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; } }

    /* Barra superior del teléfono (oculta en PC) */
    .barra-movil, .velo { display: none; }

    @media (max-width: 800px) {
      .app { grid-template-columns: minmax(0, 1fr); }
      main { padding: 16px 14px 90px; min-width: 0; }
      h1 { font-size: 21px; }
      h2 { font-size: 16px; }

      .barra-movil { display: flex; align-items: center; gap: 10px; position: sticky; top: 0; z-index: 40; padding: 8px 12px; background: var(--marino); color: #fff; box-shadow: 0 2px 8px rgba(3,18,48,.25); }
      .barra-movil .menu-btn { flex: none; width: 42px; height: 42px; padding: 0; display: grid; place-items: center; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); color: #fff; font-size: 20px; line-height: 1; }
      .barra-movil .marca img { width: 30px; height: 30px; }
      .barra-movil .marca b { color: #fff; font-size: 18px; }
      .barra-movil .marca b span { color: var(--aqua); }
      .barra-movil .donde { margin-left: auto; font-size: 12px; line-height: 1.3; color: #cfe0f5; text-align: right; max-width: 50%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      nav.lateral { position: fixed; z-index: 60; inset: 0 auto 0 0; width: min(290px, 84vw); height: 100dvh; transform: translateX(-102%); transition: transform .22s ease; box-shadow: 4px 0 24px rgba(3,18,48,.35); padding-bottom: 40px; }
      nav.lateral a { padding: 11px 12px; font-size: 15px; }
      nav.lateral .gmenu summary { padding: 12px 10px; font-size: 15px; }
      body.menu-abierto nav.lateral { transform: none; }
      body.menu-abierto .velo { display: block; position: fixed; inset: 0; z-index: 55; background: rgba(3,18,48,.5); }
      body.menu-abierto { overflow: hidden; }

      /* Formularios cómodos para el dedo (16px evita el zoom automático del iPhone) */
      input, select, textarea { font-size: 16px; padding: 9px 10px; }
      button, .btn { padding: 9px 14px; }
      button.mini { padding: 5px 9px; }
      .fila { gap: 10px 8px; }
      .fila > label { flex: 1 1 140px; }
      .fila > label input, .fila > label select { width: 100%; }
      .tarjeta { padding: 14px; overflow-x: auto; }

      /* Tablas: se desplazan dentro de su recuadro, sin estirar la página */
      .tabla { -webkit-overflow-scrolling: touch; }
      table { font-size: 13px; }
      th, td { padding: 7px 6px; }
      th { font-size: 12px; }
      td input { font-size: 15px; padding: 6px; }
      td textarea { min-width: 230px; }
      td b, td a { white-space: nowrap; }
      /* El nombre del estudiante queda fijo a la izquierda al desplazar la tabla */
      td.nom { white-space: nowrap; position: sticky; left: 0; z-index: 1; background: #fff; box-shadow: inset -1px 0 0 var(--linea); }
      .grid-kpi { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
      .kpi { padding: 12px; }
      .kpi b { font-size: 22px; }

      .marca-agua-inicio { width: min(88vw, 450px); opacity: .18; }
      .acceso { justify-content: center; padding: 16px; background-position: 75% center; }
    }
    @media print {
      nav.lateral, .barra-movil, .velo, .no-print, button, .btn { display: none !important; }
      .app { display: block; } main { padding: 0; max-width: none; }
      .tarjeta, .tabla { border: none; box-shadow: none; } .solo-print { display: block; }
      th { position: static; color: var(--tinta); background: #eef3f6; }
      tr:hover td { background: none; }
    }
  </style>
</head>
<body>
  {sinMenu ? <slot /> : (
    <header class="barra-movil">
      <button type="button" class="menu-btn" aria-label="Abrir menú" aria-controls="menu" aria-expanded="false" data-menu>☰</button>
      <a class="marca" href="/"><img src="/logo-claro.svg" alt="" /><b>NE<span>XO</span></b></a>
      {inst && <span class="donde">{inst.nombre}{periodo && <><br />{periodo.nombre}</>}</span>}
    </header>
    <div class="velo" data-menu></div>
    <div class="app">
      <nav class="lateral" id="menu">
        <a class="marca" href="/"><img src="/logo-claro.svg" alt="" /><div><b>NE<span>XO</span></b><small>Registro digital docente</small></div></a>
        <div class="quien">{user?.nombre} · <a href="/cuenta">Mi cuenta</a></div>
        {inst && <div class="colegio">{logoColegio(inst) && <img class="escudo" src={logoColegio(inst)!} alt="" />}<div>{inst.nombre}{instituciones.length > 1 && <a href="/elegir-colegio">Cambiar de colegio</a>}</div></div>}
        {inst && periodos.length > 0 && (
          <label class="periodo-trabajo">Periodo de trabajo
            <select onchange={`location = '/periodo?id=' + this.value + '&volver=' + encodeURIComponent(location.pathname + location.search)`}>
              {periodos.map((p) => <option value={p.id} selected={p.id === periodo?.id}>{p.nombre}</option>)}
            </select>
          </label>
        )}
        {inst && <a href="/" class={`ir-inicio ${activo('/') ? 'on' : ''}`} aria-current={activo('/') ? 'page' : undefined}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONOS.inicio} />Inicio</a>}
        {menuGrupos.map((g) => {
          const aqui = g.items.some(([h]) => activo(h));
          return (
            <details class="gmenu" data-g={g.clave} data-aqui={aqui ? '1' : ''} open={aqui || g.abierto}>
              <summary><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONOS[g.clave]} /><span>{g.titulo}</span><svg class="flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></summary>
              <div class="items">{g.items.map(([h, t]) => <a href={h} class={activo(h) ? 'on' : ''} aria-current={activo(h) ? 'page' : undefined}>{t}</a>)}</div>
            </details>
          );
        })}
        <form method="post" action="/login?salir=1"><button type="submit">Salir</button></form>
      </nav>
      <main><slot /></main>
    </div>
  )}
  <script is:inline>
    // Grupos del menú: recordar cuáles dejó abiertos (el de la página actual siempre abierto)
    (() => {
      let guardado = null;
      try { guardado = JSON.parse(localStorage.getItem('nexo-menu') || 'null'); } catch {}
      const grupos = document.querySelectorAll('nav.lateral details.gmenu');
      if (guardado) grupos.forEach((d) => { if (!d.dataset.aqui && d.dataset.g in guardado) d.open = guardado[d.dataset.g]; });
      grupos.forEach((d) => d.addEventListener('toggle', () => {
        const estado = {}; grupos.forEach((x) => { estado[x.dataset.g] = x.open; });
        try { localStorage.setItem('nexo-menu', JSON.stringify(estado)); } catch {}
      }));
    })();
    // Menú lateral del teléfono
    document.querySelectorAll('[data-menu]').forEach((el) => el.addEventListener('click', () => {
      const abierto = document.body.classList.toggle('menu-abierto');
      document.querySelector('.menu-btn')?.setAttribute('aria-expanded', String(abierto));
    }));
  </script>
</body>
</html>
