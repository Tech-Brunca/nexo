---
interface Props { titulo: string; sinMenu?: boolean }
const { titulo, sinMenu = false } = Astro.props;
const ruta = Astro.url.pathname;
import { logoColegio } from '../lib/auth';
const { user, inst, instituciones, periodos = [], periodo = null } = Astro.locals;
// Menú agrupado por lo que el docente va a hacer. Cada grupo se pliega; el de la página actual queda abierto.
// Íconos propios (trazo de 1,8 px, 24×24) que heredan el color del texto.
const ICONOS: Record<string, string> = {
  inicio: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5.5h4V20"/>',
  aula: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20l2.5-4M16 20l-2.5-4M7 9h6M7 12h9"/>',
  grupos: '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19c.6-3 2.8-4.8 5.5-4.8s4.9 1.8 5.5 4.8"/><circle cx="16.5" cy="9.5" r="2.4"/><path d="M15.5 14.4c2.6-.3 4.5 1.3 5 4.1"/>',
  resultados: '<path d="M4 20h16"/><rect x="5.5" y="11" width="3" height="6.5" rx=".6"/><rect x="10.5" y="7" width="3" height="10.5" rx=".6"/><rect x="15.5" y="13" width="3" height="4.5" rx=".6"/>',
  familias: '<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h0A2.5 2.5 0 0 1 4 13.5Z"/><path d="M8.5 9.5h7M8.5 12.5h4.5"/>',
  preparar: '<rect x="5" y="4.5" width="14" height="16" rx="2"/><path d="M9 4.5V3.5h6v1"/><path d="m8.5 11 1.8 1.8L13.5 9.6M8.5 16.5h7"/>',
  evaluar: '<path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3Z"/><path d="m13.5 8.5 3 3"/>',
  cuenta: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.6 7-5.6s6.2 2 7 5.6"/>',
  admin: '<path d="M12 3.5 5 6.5v5c0 4.3 3 7.6 7 9 4-1.4 7-4.7 7-9v-5Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
};
// Menú superior por proceso: preparar el curso → dar clases → evaluar → resultados → familias.
// Cada grupo abre un panel (mega menú) con sus páginas y una línea de qué hace cada una; debajo de la barra,
// las páginas del grupo actual quedan a la vista con la actual marcada.
type Item = [string, string, string?];
type Grupo = { clave: string; titulo: string; paso?: number; ayuda: string; items: Item[] };
const grupos: Grupo[] = [
  { clave: 'preparar', titulo: 'Preparar', paso: 1, ayuda: 'Lo que se arma al inicio del curso', items: [
    ['/ajustes', 'Materias y ajustes', 'Materias con su tipo del MEP, escala de asistencia'],
    ['/secciones', 'Secciones', 'Grupos, subgrupos y su materia'],
    ['/estudiantes', 'Estudiantes', 'Lista, encargados y perfil de cada uno'],
    ['/periodos', 'Periodos', 'Fechas del I y II periodo'],
    ['/componentes', 'Componentes', 'Porcentajes de cada materia y nivel'],
    ['/indicadores', 'Indicadores', 'Indicadores del trabajo cotidiano'],
    ['/plan', 'Plan anual', 'Cargar el plan y ver el avance de cada sección'],
  ] },
  { clave: 'aula', titulo: 'En clase', paso: 2, ayuda: 'Lo de todos los días', items: [
    ['/bitacora', 'Bitácora', 'Minuta de la clase y anotaciones'],
    ['/asistencia', 'Asistencia', 'Pasar lista y ver ausencias'],
  ] },
  { clave: 'evaluar', titulo: 'Evaluar', paso: 3, ayuda: 'Calificar y llevar las notas', items: [
    ['/evaluaciones', 'Evaluaciones', 'Pruebas, tareas, proyectos y trabajo cotidiano'],
    ['/notas', 'Calificaciones', 'Nota del periodo por componente'],
    ['/sea', 'Importar / exportar SEA', 'Plantilla de notas del SEA'],
  ] },
  { clave: 'resultados', titulo: 'Resultados', paso: 4, ayuda: 'Informes y seguimiento', items: [
    ['/anual', 'Nota anual', 'Promedio de los periodos y condición final'],
    ['/informes', 'Informes', 'Reportes, eximidos y reconocimientos'],
    ['/alertas', 'Alerta temprana', 'Estudiantes con ausencias que alertar'],
  ] },
  { clave: 'familias', titulo: 'Familias', paso: 5, ayuda: 'Comunicación con los encargados', items: [
    ['/comunicados', 'Comunicados', 'Mensajes por WhatsApp a un grupo'],
    ['/comunicados#un-estudiante', 'A un estudiante', 'Comunicado al hogar por WhatsApp o impreso'],
    ['/plantillas', 'Mensajes WhatsApp', 'Plantillas de los avisos'],
    ['/plantillas-hogar', 'Plantillas al hogar', 'Plantillas de los comunicados al hogar'],
  ] },
];
const admin: Grupo = { clave: 'admin', titulo: 'Administración', ayuda: 'Solo administradores', items: [
  ['/admin/usuarios', 'Usuarios', 'Aprobar y administrar cuentas'], ['/admin/colegios', 'Colegios', 'Colegios y su escudo'],
  ['/admin/componentes-mep', 'Componentes del MEP', 'Matriz del Reglamento de Evaluación por año'],
] };
// Sin colegio elegido solo se puede preparar la cuenta (materias y ajustes)
const menuGrupos = [...(inst ? grupos : [{ ...grupos[0], items: grupos[0].items.filter(([h]) => h === '/ajustes') }]), ...(user?.rol === 'admin' ? [admin] : [])];
const activo = (h: string) => (h === '/' ? ruta === '/' : !h.includes('#') && (ruta === h || ruta.startsWith(h + '/')));
const actual = menuGrupos.find((g) => g.items.some(([h]) => activo(h)));
const iniciales = (user?.nombre ?? '?').split(/\s+/).slice(0, 2).map((w: string) => w[0]).join('').toUpperCase();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0A3D91" />
  <link rel="icon" href="/favicon.svg" />
  <title>{titulo} · Nexo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      /* Paleta de marca Nexo */
      --marino: #0A3D91; --marino-osc: #072B6A; --teal: #0C7C90; --cian: #12CFF3; --aqua: #49E1FF;
      --hielo: #EAF8FC; --gris: #F4F7FA;
      /* Uso */
      --tinta: #13233f; --suave: #5a6b82; --linea: #dde6ef; --papel: var(--gris); --blanco: #fff;
      --verde: #137a52; --verde-claro: #e2f5ec; --rojo: #b3402f; --rojo-claro: #fbe9e5; --ambar: #a86b00; --ambar-claro: #fff3d6;
      --titulos: 'Montserrat', 'Segoe UI', system-ui, sans-serif;
      --texto: 'Atkinson Hyperlegible Next', 'Atkinson Hyperlegible', 'Segoe UI', system-ui, sans-serif;
      font-family: var(--texto); font-size: 15px; line-height: 1.45; color: var(--tinta); background: var(--papel);
    }
    * { box-sizing: border-box; }
    body { margin: 0; }
    a { color: var(--teal); }
    a:hover { color: var(--marino); }
    /* Barra superior con mega menú (por proceso) */
    :root { --alto-barra: 60px; }
    .barra { position: sticky; top: 0; z-index: 50; height: var(--alto-barra); display: flex; align-items: center; gap: 14px; padding: 0 18px;
      background: linear-gradient(90deg, var(--marino-osc) 0%, var(--marino) 60%); color: #fff; box-shadow: 0 2px 10px rgba(3,18,48,.22); }
    .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .marca img { width: 34px; height: 34px; flex: none; }
    .marca b { font-family: var(--titulos); font-weight: 800; font-size: 21px; letter-spacing: .02em; line-height: 1; color: #fff; }
    .marca b span { color: var(--aqua); }
    .marca small { display: block; font-size: 11px; font-weight: 400; margin-top: 3px; }
    .barra .marca { flex: none; margin-right: 4px; }
    .menu-btn { display: none; }
    nav.menu { display: flex; align-items: center; gap: 2px; flex: 1; min-width: 0; height: 100%; }
    nav.menu .ico, .barra .ico { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    nav.menu > a.mm-hoy, .mm > summary { display: flex; align-items: center; gap: 7px; height: 40px; padding: 0 11px; border-radius: 9px; color: #d4e4f7; text-decoration: none;
      font-size: 14px; font-weight: 600; cursor: pointer; user-select: none; white-space: nowrap; list-style: none; -webkit-tap-highlight-color: transparent; position: relative; }
    .mm > summary::-webkit-details-marker { display: none; }
    nav.menu > a.mm-hoy:hover, .mm > summary:hover, .mm[open] > summary { background: rgba(255,255,255,.1); color: #fff; }
    nav.menu > a.mm-hoy.on, .mm[data-aqui="1"] > summary { color: #fff; background: rgba(18,207,243,.18); }
    nav.menu > a.mm-hoy.on::after, .mm[data-aqui="1"] > summary::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: -10px; height: 3px; border-radius: 3px; background: var(--cian); }
    .mm > summary:focus-visible, nav.menu > a:focus-visible { outline: 3px solid rgba(18,207,243,.6); outline-offset: -2px; }
    .paso { font-style: normal; display: inline-grid; place-items: center; width: 19px; height: 19px; border-radius: 50%; font-size: 11px; font-weight: 700;
      background: rgba(255,255,255,.14); color: #fff; }
    .mm[data-aqui="1"] .paso { background: var(--cian); color: var(--marino-osc); }
    .flecha { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: .7; transition: transform .15s ease; }
    .mm[open] > summary .flecha { transform: rotate(180deg); }
    .mm { position: relative; }
    .mm-panel { position: absolute; top: calc(100% + 10px); left: 0; z-index: 60; width: max-content; min-width: 300px; max-width: min(620px, 92vw);
      background: #fff; color: var(--tinta); border: 1px solid var(--linea); border-radius: 14px; padding: 14px; box-shadow: 0 18px 40px rgba(3,18,48,.22); }
    .mm-panel::before { content: ''; position: absolute; top: -7px; left: 22px; width: 12px; height: 12px; background: #fff; border-left: 1px solid var(--linea); border-top: 1px solid var(--linea); transform: rotate(45deg); }
    .mm:nth-last-of-type(-n+2) .mm-panel { left: auto; right: 0; }
    .mm:nth-last-of-type(-n+2) .mm-panel::before { left: auto; right: 22px; }
    .mm-ayuda { margin: 0 4px 10px; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--teal); }
    .mm-items { display: grid; grid-template-columns: repeat(var(--cols, 1), minmax(220px, 1fr)); gap: 2px 8px; }
    .mm-items a { display: block; padding: 9px 12px; border-radius: 9px; text-decoration: none; color: var(--tinta); border-left: 3px solid transparent; }
    .mm-items a b { display: block; font-size: 14.5px; color: var(--marino); }
    .mm-items a small { display: block; font-size: 12.5px; color: var(--suave); margin-top: 1px; }
    .mm-items a:hover { background: var(--hielo); }
    .mm-items a.on { background: var(--hielo); border-left-color: var(--cian); }
    .barra-der { display: flex; align-items: center; gap: 10px; flex: none; }
    .barra .per-barra { display: flex; flex-direction: row; align-items: center; gap: 6px; font-size: 12px; color: #a9c4e6; }
    .per-barra select { font-weight: 600; font-size: 14px; padding: 6px 8px; background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(73,225,255,.35); }
    .per-barra select option { color: var(--tinta); }
    .colegio-chip { display: flex; align-items: center; gap: 8px; max-width: 190px; color: #fff; text-decoration: none; font-size: 13px; font-weight: 600; line-height: 1.15; }
    .colegio-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .colegio-chip .escudo { width: 32px; height: 32px; object-fit: contain; flex: none; background: #fff; border-radius: 7px; padding: 2px; }
    .colegio-chip:hover { color: var(--aqua); }
    .cuenta { position: relative; }
    .cuenta > summary { list-style: none; cursor: pointer; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 13px;
      background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.28); color: #fff; }
    .cuenta > summary::-webkit-details-marker { display: none; }
    .cuenta > summary:hover, .cuenta[open] > summary { background: rgba(255,255,255,.24); }
    .cuenta .mm-panel { left: auto; right: 0; min-width: 240px; }
    .cuenta .mm-panel::before { left: auto; right: 14px; }
    .cuenta-quien { padding: 4px 12px 10px; border-bottom: 1px solid var(--linea); margin-bottom: 6px; }
    .cuenta-quien b { display: block; color: var(--marino); }
    .cuenta-quien span { font-size: 12.5px; color: var(--suave); }
    .cuenta form button { width: 100%; margin-top: 8px; }
    .menu-movil-cab { display: none; }

    /* Páginas del grupo actual: siempre a la vista bajo la barra */
    .subnav { display: flex; align-items: center; gap: 4px; padding: 0 30px; background: #fff; border-bottom: 1px solid var(--linea); overflow-x: auto; scrollbar-width: thin; }
    .subnav .sg { flex: none; display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--teal); margin-right: 10px; padding: 12px 0; }
    .subnav .sg .paso { background: var(--hielo); color: var(--teal); }
    .subnav a { flex: none; padding: 12px 12px 10px; font-size: 14px; color: var(--suave); text-decoration: none; border-bottom: 3px solid transparent; white-space: nowrap; }
    .subnav a:hover { color: var(--marino); background: var(--gris); }
    .subnav a.on { color: var(--marino); font-weight: 700; border-bottom-color: var(--cian); }
    .velo { display: none; }

    /* Contenido */
    main { padding: 24px 30px 60px; max-width: 1400px; margin: 0 auto; }
    h1, h2 { font-family: var(--titulos); color: var(--marino); }
    h1 { font-size: 24px; font-weight: 700; margin: 0 0 4px; }
    .sub { color: var(--suave); margin: 0 0 20px; font-size: 14px; }
    h2 { font-size: 17px; font-weight: 700; margin: 28px 0 10px; }
    .tarjeta { background: var(--blanco); border: 1px solid var(--linea); border-radius: 12px; padding: 16px 18px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(10,61,145,.04); }
    .fila { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
    label { display: flex; flex-direction: column; font-size: 12px; color: var(--suave); gap: 4px; }
    input, select, textarea { font: inherit; font-size: 14px; padding: 7px 9px; border: 1px solid #c6d4e3; border-radius: 8px; background: #fff; color: var(--tinta); }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--cian); box-shadow: 0 0 0 3px rgba(18,207,243,.22); }
    textarea { min-height: 70px; }
    button, .btn { font: inherit; font-size: 14px; font-weight: 600; padding: 7px 14px; border-radius: 8px; border: 1px solid var(--marino); background: var(--marino); color: #fff; cursor: pointer; text-decoration: none; display: inline-block; transition: background .15s, border-color .15s; }
    button:hover, .btn:hover { background: var(--marino-osc); border-color: var(--marino-osc); color: #fff; }
    button:disabled, .btn[aria-disabled="true"] { opacity: .5; cursor: not-allowed; }
    button.sec, .btn.sec { background: #fff; color: var(--marino); border-color: #c6d4e3; }
    button.sec:hover, .btn.sec:hover { background: var(--hielo); border-color: var(--cian); }
    button.peligro { background: #fff; color: var(--rojo); border-color: var(--rojo); }
    button.peligro:hover { background: var(--rojo-claro); }
    button.mini { padding: 3px 8px; font-size: 12px; }
    button:focus-visible, .btn:focus-visible, a:focus-visible { outline: 3px solid rgba(18,207,243,.5); outline-offset: 2px; }
    table { border-collapse: collapse; width: 100%; background: #fff; font-size: 14px; }
    th, td { border-bottom: 1px solid var(--linea); padding: 7px 8px; text-align: left; vertical-align: middle; }
    th { background: var(--hielo); font-size: 13px; font-weight: 600; color: #3d5a73; position: sticky; top: 0; }
    tr:hover td { background: #f8fcfe; }
    td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
    table { font-variant-numeric: tabular-nums; }
    td input { padding: 4px 6px; width: 100%; min-width: 60px; }
    td input[type=checkbox], td input[type=radio] { width: auto; min-width: 0; }
    .tabla { overflow-x: auto; border: 1px solid var(--linea); border-radius: 12px; }
    .chip { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 12px; font-weight: 600; }
    .ok { background: var(--verde-claro); color: var(--verde); }
    .mal { background: var(--rojo-claro); color: var(--rojo); }
    .aviso { background: var(--ambar-claro); color: var(--ambar); }
    .msg { padding: 10px 14px; border-radius: 10px; margin-bottom: 14px; font-size: 14px; }
    .grid-kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
    .kpi { background: #fff; border: 1px solid var(--linea); border-top: 3px solid var(--cian); border-radius: 12px; padding: 14px 16px; }
    .kpi b { display: block; font-family: var(--titulos); font-size: 26px; color: var(--marino); }
    .kpi span { color: var(--suave); font-size: 13px; }
    .inicio { min-height: calc(100vh - var(--alto-barra) - 84px); }
    .marca-agua-inicio { display: block; width: min(57vw, 495px); max-height: 360px; margin: 4px auto 18px; object-fit: contain; opacity: .22; filter: saturate(.8) blur(.3px); pointer-events: none; user-select: none; }
    .muted { color: var(--suave); font-size: 13px; }
    .solo-print { display: none; }

    /* Pantallas de ingreso */
    .acceso { min-height: 100vh; display: flex; align-items: center; padding: 24px 6vw; background: #071f4d url('/fondo-acceso.webp') center right / cover no-repeat; }
    .acceso-tarjeta { width: min(420px, 100%); padding: 30px 30px 24px !important; border: 0 !important; border-radius: 16px !important; box-shadow: 0 20px 50px rgba(3,18,48,.45); }
    .acceso-tarjeta .marca { flex-direction: column; text-align: center; gap: 8px; margin-bottom: 18px; }
    .acceso-tarjeta .marca img { width: 76px; height: 76px; }
    .acceso-tarjeta .marca b { color: var(--marino); font-size: 34px; }
    .acceso-tarjeta .marca small { color: var(--suave); font-size: 13px; }
    .acceso-tarjeta h1 { font-size: 20px; text-align: center; }
    .acceso-tarjeta .sub { text-align: center; }
    .acceso-tarjeta button { padding: 10px 14px; font-size: 15px; }

    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; } }

    /* Pantallas medianas y teléfono: el menú pasa a un panel lateral con los grupos plegables;
       el grupo de la página actual queda abierto y los demás cerrados */
    @media (max-width: 1280px) {
      .barra .per-barra > span, .barra-der .colegio-chip span { display: none; }
      .barra-der .colegio-chip:not(:has(img)) { display: none; }
      nav.menu > a.mm-hoy, .mm > summary { padding: 0 9px; gap: 6px; }
      .mm > summary .flecha { display: none; }
    }
    @media (max-width: 1080px) {
      .barra { gap: 10px; padding: 0 12px; }
      .menu-btn { display: grid; place-items: center; flex: none; width: 42px; height: 42px; padding: 0; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); color: #fff; font-size: 20px; line-height: 1; }
      .barra-der { margin-left: auto; }
      .per-barra, .colegio-chip { display: none; }
      nav.menu { position: fixed; z-index: 70; inset: 0 auto 0 0; width: min(320px, 86vw); height: 100dvh; flex-direction: column; align-items: stretch; gap: 2px;
        padding: 14px 12px 40px; overflow-y: auto; background: linear-gradient(180deg, var(--marino) 0%, var(--marino-osc) 100%);
        transform: translateX(-102%); transition: transform .22s ease; box-shadow: 4px 0 24px rgba(3,18,48,.35); }
      body.menu-abierto nav.menu { transform: none; }
      body.menu-abierto .barra { z-index: 80; }
      .mm > summary .flecha { display: block; }
      body.menu-abierto .velo { display: block; position: fixed; inset: 0; z-index: 65; background: rgba(3,18,48,.5); }
      body.menu-abierto { overflow: hidden; }
      .menu-movil-cab { display: flex; flex-direction: column; gap: 10px; margin: 0 4px 12px; color: #cfe0f5; font-size: 13px; }
      .menu-movil-cab .marca small { color: #a9c4e6; }
      .menu-movil-cab .colegio-chip { display: flex; max-width: none; }
      .menu-movil-cab .colegio-chip span { display: inline; white-space: normal; }
      .menu-movil-cab .per-barra { display: flex; flex-direction: column; align-items: stretch; gap: 4px; color: #a9c4e6; font-size: 12.5px; }
      .menu-movil-cab .per-barra select { width: 100%; font-weight: 600; font-size: 15px; background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(73,225,255,.35); }
      .menu-movil-cab .per-barra select option { color: var(--tinta); }
      .menu-movil-cab .per-barra > span { display: inline; }
      nav.menu > a.mm-hoy, .mm > summary { height: auto; padding: 12px 10px; font-size: 15px; }
      nav.menu > a.mm-hoy.on::after, .mm[data-aqui="1"] > summary::after { display: none; }
      .mm > summary .flecha { margin-left: auto; }
      .mm-panel { position: static; width: auto; min-width: 0; max-width: none; background: transparent; border: 0; box-shadow: none; padding: 2px 0 8px 18px; }
      .mm-panel::before, .mm-ayuda { display: none; }
      .mm-items { grid-template-columns: 1fr !important; border-left: 1px solid rgba(255,255,255,.14); padding-left: 8px; }
      .mm-items a { color: #d4e4f7; padding: 10px; }
      .mm-items a b { color: inherit; font-weight: 600; font-size: 15px; }
      .mm-items a small { display: none; }
      .mm-items a:hover { background: rgba(255,255,255,.08); }
      .mm-items a.on { background: rgba(18,207,243,.16); color: #fff; }
      .subnav { padding: 0 10px; }
    }
    @media (max-width: 800px) {
      main { padding: 16px 14px 90px; min-width: 0; }
      h1 { font-size: 21px; }
      h2 { font-size: 16px; }

      /* Formularios cómodos para el dedo (16px evita el zoom automático del iPhone) */
      input, select, textarea { font-size: 16px; padding: 9px 10px; }
      button, .btn { padding: 9px 14px; }
      button.mini { padding: 5px 9px; }
      .fila { gap: 10px 8px; }
      .fila > label { flex: 1 1 140px; }
      .fila > label input, .fila > label select { width: 100%; }
      .tarjeta { padding: 14px; overflow-x: auto; }

      /* Tablas: se desplazan dentro de su recuadro, sin estirar la página */
      .tabla { -webkit-overflow-scrolling: touch; }
      table { font-size: 13px; }
      th, td { padding: 7px 6px; }
      th { font-size: 12px; }
      td input { font-size: 15px; padding: 6px; }
      td textarea { min-width: 230px; }
      td b, td a { white-space: nowrap; }
      /* El nombre del estudiante queda fijo a la izquierda al desplazar la tabla */
      td.nom { white-space: nowrap; position: sticky; left: 0; z-index: 1; background: #fff; box-shadow: inset -1px 0 0 var(--linea); }
      .grid-kpi { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
      .kpi { padding: 12px; }
      .kpi b { font-size: 22px; }

      .marca-agua-inicio { width: min(88vw, 450px); opacity: .18; }
      .acceso { justify-content: center; padding: 16px; background-position: 75% center; }
    }
    @media print {
      .barra, .subnav, .velo, .no-print, button, .btn { display: none !important; }
      main { padding: 0; max-width: none; }
      .tarjeta, .tabla { border: none; box-shadow: none; } .solo-print { display: block; }
      th { position: static; color: var(--tinta); background: #eef3f6; }
      tr:hover td { background: none; }
    }
  </style>
</head>
<body>
  {sinMenu ? <slot /> : (
    <>
      <header class="barra">
        <button type="button" class="menu-btn" aria-label="Abrir menú" aria-controls="menu" aria-expanded="false" data-menu>☰</button>
        <a class="marca" href="/"><img src="/logo-claro.svg" alt="" /><b>NE<span>XO</span></b></a>
        <nav class="menu" id="menu" aria-label="Menú principal">
          <div class="menu-movil-cab">
            <a class="marca" href="/"><img src="/logo-claro.svg" alt="" /><div><b>NE<span>XO</span></b><small>Registro digital docente</small></div></a>
            {inst && <a class="colegio-chip" href={instituciones.length > 1 ? '/elegir-colegio' : '/'}>{logoColegio(inst) && <img class="escudo" src={logoColegio(inst)!} alt="" />}<span>{inst.nombre}</span></a>}
            {inst && periodos.length > 0 && (
              <label class="per-barra"><span>Periodo de trabajo</span>
                <select onchange={`location = '/periodo?id=' + this.value + '&volver=' + encodeURIComponent(location.pathname + location.search)`}>
                  {periodos.map((p) => <option value={p.id} selected={p.id === periodo?.id}>{p.nombre}</option>)}
                </select>
              </label>
            )}
          </div>
          {inst && <a href="/" class={`mm-hoy ${activo('/') ? 'on' : ''}`} aria-current={activo('/') ? 'page' : undefined}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONOS.inicio} />Inicio</a>}
          {menuGrupos.map((g) => (
            <details class="mm" data-g={g.clave} data-aqui={g === actual ? '1' : ''}>
              <summary>{g.paso ? <i class="paso">{g.paso}</i> : <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONOS[g.clave]} />}<span>{g.titulo}</span><svg class="flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
              <div class="mm-panel">
                <p class="mm-ayuda">{g.paso && `Paso ${g.paso} · `}{g.ayuda}</p>
                <div class="mm-items" style={`--cols:${g.items.length > 4 ? 2 : 1}`}>
                  {g.items.map(([h, t, d]) => <a href={h} class={activo(h) ? 'on' : ''} aria-current={activo(h) ? 'page' : undefined}><b>{t}</b>{d && <small>{d}</small>}</a>)}
                </div>
              </div>
            </details>
          ))}
        </nav>
        <div class="barra-der">
          {inst && periodos.length > 0 && (
            <label class="per-barra"><span>Periodo</span>
              <select aria-label="Periodo de trabajo" onchange={`location = '/periodo?id=' + this.value + '&volver=' + encodeURIComponent(location.pathname + location.search)`}>
                {periodos.map((p) => <option value={p.id} selected={p.id === periodo?.id}>{p.nombre}</option>)}
              </select>
            </label>
          )}
          {inst && <a class="colegio-chip" title={instituciones.length > 1 ? `${inst.nombre} · cambiar de colegio` : inst.nombre} href={instituciones.length > 1 ? '/elegir-colegio' : '/'}>{logoColegio(inst) && <img class="escudo" src={logoColegio(inst)!} alt="" />}<span>{inst.nombre}</span></a>}
          <details class="cuenta">
            <summary aria-label="Mi cuenta" title={user?.nombre}>{iniciales}</summary>
            <div class="mm-panel">
              <div class="cuenta-quien"><b>{user?.nombre}</b><span>{user?.correo}</span></div>
              <div class="mm-items">
                <a href="/cuenta" class={activo('/cuenta') ? 'on' : ''}><b>Mi cuenta</b><small>Nombre, correo y contraseña</small></a>
                <a href="/respaldo" class={activo('/respaldo') ? 'on' : ''}><b>Respaldo</b><small>Descargar o restaurar sus datos</small></a>
                {instituciones.length > 1 && <a href="/elegir-colegio"><b>Cambiar de colegio</b></a>}
              </div>
              <form method="post" action="/login?salir=1"><button type="submit" class="sec">Salir</button></form>
            </div>
          </details>
        </div>
      </header>
      <div class="velo" data-menu></div>
      {actual && (
        <nav class="subnav" aria-label={actual.titulo}>
          <span class="sg">{actual.paso ? <i class="paso">{actual.paso}</i> : <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONOS[actual.clave]} />}{actual.titulo}</span>
          {actual.items.map(([h, t]) => <a href={h} class={activo(h) ? 'on' : ''} aria-current={activo(h) ? 'page' : undefined}>{t}</a>)}
        </nav>
      )}
      <main><slot /></main>
    </>
  )}
  <script is:inline>
    (() => {
      const angosto = () => matchMedia('(max-width: 1080px)').matches;
      const menus = [...document.querySelectorAll('.barra details.mm, .barra details.cuenta')];
      // En el panel del teléfono, el grupo actual empieza abierto y los demás cerrados
      if (angosto()) document.querySelector('.barra details.mm[data-aqui="1"]')?.setAttribute('open', '');
      // En la PC, un solo panel abierto a la vez; se cierra al tocar fuera o con Escape
      menus.forEach((d) => d.addEventListener('toggle', () => {
        if (d.open && (!angosto() || d.classList.contains('cuenta'))) menus.forEach((o) => { if (o !== d) o.open = false; });
      }));
      const cerrar = () => menus.forEach((d) => { if (!angosto() || d.classList.contains('cuenta')) d.open = false; });
      document.addEventListener('click', (e) => { if (!e.target.closest('.barra details')) cerrar(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const a = menus.find((d) => d.open); cerrar(); a?.querySelector('summary')?.focus(); } });
      // Panel lateral del teléfono
      document.querySelectorAll('[data-menu]').forEach((el) => el.addEventListener('click', () => {
        const abierto = document.body.classList.toggle('menu-abierto');
        document.querySelector('.menu-btn')?.setAttribute('aria-expanded', String(abierto));
      }));
    })();
  </script>
</body>
</html>
