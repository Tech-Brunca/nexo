---
import Base from '../layouts/Base.astro';
import { exec, q, one, transaccion, preparar, esquemaActual } from '../lib/db';
import { num, str } from '../lib/util';
import { SEA, asegurarComponentes, ajustarPruebasSea, PRUEBA1_DEFECTO } from '../lib/sea';
import { reglaDeMateria, aplicarRegla, crearEvaluacionesPlan, resumenRegla } from '../lib/reac';
let msg = '', error = '', avisos: string[] = [];
const { user, inst } = Astro.locals;
const U = user.id;
// Los componentes son por nivel y materia: cada combinación de sus secciones
const combos = await q<any>(`SELECT DISTINCT s.nivel, COALESCE(s.asignatura_id,0) AS asig, a.nombre AS asignatura, length(s.nivel) AS ln FROM {S}.secciones s
  LEFT JOIN general.asignaturas a ON a.id=s.asignatura_id WHERE s.usuario_id=? ORDER BY ln, s.nivel, a.nombre`, [U]);
const clave = (n: string, a: number) => `${n}|${a}`;
const etiqueta = (c: any) => `${/^\d+$/.test(c.nivel) ? c.nivel + '.°' : c.nivel} · ${c.asignatura ?? 'Sin materia'}`;
const pedido = combos.find((c) => c.nivel === Astro.url.searchParams.get('nivel') && Number(c.asig) === Number(Astro.url.searchParams.get('asignatura') ?? -1))
  ?? combos.find((c) => c.nivel === Astro.url.searchParams.get('nivel')) ?? combos[0];
let nivel = pedido?.nivel ?? '';
let asig = Number(pedido?.asig ?? 0);
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  nivel = str(f.get('nivel')) || nivel;
  if (f.has('asignatura')) asig = num(f.get('asignatura'));
  const accion = str(f.get('accion'));
  if (accion === 'guardar') {
    const ids = f.getAll('id');
    for (let i = 0; i < ids.length; i++) {
      const pct = Number(str(f.getAll('porcentaje')[i]).replace(',', '.'));
      if (!(pct >= 0 && pct <= 100)) { error = 'Cada porcentaje debe estar entre 0 y 100.'; break; }
    }
    if (!error) {
      for (let i = 0; i < ids.length; i++) {
        const tipo = str(f.getAll('tipo')[i]);
        // El nombre no se toca: es la columna del SEA. Asistencia siempre se calcula sola.
        await exec(`UPDATE {S}.componentes SET porcentaje=?, tipo=CASE WHEN clave='asistencia' THEN 'asistencia' WHEN ? IN ('puntos','indicadores') THEN ? ELSE tipo END
          WHERE id=? AND usuario_id=?`, [Number(str(f.getAll('porcentaje')[i]).replace(',', '.')), tipo, tipo, num(ids[i]), U]);
      }
      // Valor de la I prueba del II periodo (el SEA trae solo esa nota); la II prueba es el resto
      const idPrueba = num(f.get('prueba_id'));
      if (idPrueba && str(f.get('prueba1')) !== '') {
        const p1 = Number(str(f.get('prueba1')).replace(',', '.'));
        const total = Number((await one<any>('SELECT porcentaje FROM {S}.componentes WHERE id=? AND usuario_id=?', [idPrueba, U]))?.porcentaje ?? 0);
        // Notas de I prueba ya importadas en el II periodo que no cabrían en el nuevo valor
        const choque = await one<any>(`SELECT s.nivel || '-' || s.nombre AS seccion, MAX(n.puntos) AS maximo FROM {S}.evaluaciones e
          JOIN {S}.secciones s ON s.id=e.seccion_id JOIN {S}.periodos p ON p.id=e.periodo_id JOIN {S}.notas n ON n.evaluacion_id=e.id
          WHERE e.componente_id=? AND e.origen='sea' AND p.numero=2 GROUP BY s.id HAVING MAX(n.puntos) > ? LIMIT 1`, [idPrueba, p1]);
        if (!(p1 > 0 && p1 < total)) error = `La I prueba debe valer más de 0 y menos que la Prueba (${total} %).`;
        else if (choque) error = `No se cambió el valor de la I prueba: en ${choque.seccion} hay notas importadas de hasta ${Number(choque.maximo)}, mayores que ${p1} %.`;
        else {
          await exec('UPDATE {S}.componentes SET prueba1=? WHERE id=? AND usuario_id=?', [p1, idPrueba, U]);
          avisos = await ajustarPruebasSea(U, nivel, asig || null);
        }
      }
      msg = error ? 'Porcentajes guardados, excepto el valor de la I prueba.' : 'Porcentajes guardados.';
    }
  } else if (accion === 'copiar') {
    const [dn, da] = str(f.get('destino')).split('|');
    const dest = combos.find((c) => c.nivel === dn && Number(c.asig) === Number(da));
    if (dest) {
      await asegurarComponentes(U, dest.nivel, Number(dest.asig) || null);
      await exec(`UPDATE {S}.componentes d SET porcentaje=o.porcentaje, tipo=o.tipo, nombre=o.nombre, prueba1=o.prueba1 FROM {S}.componentes o
        WHERE o.usuario_id=? AND o.nivel=? AND COALESCE(o.asignatura_id,0)=? AND d.usuario_id=o.usuario_id AND d.nivel=? AND COALESCE(d.asignatura_id,0)=? AND d.clave=o.clave`,
        [U, nivel, asig, dest.nivel, Number(dest.asig)]);
      msg = `Porcentajes copiados a ${etiqueta(dest)}.`;
    }
  } else if (accion === 'mep') {
    // Aplica los porcentajes del reglamento de la materia y crea las pruebas que falten en sus secciones
    const m = asig ? await reglaDeMateria(U, asig) : null;
    if (!m) error = 'Esta materia no tiene tipo del MEP. Elíjalo en Ajustes → Mis materias.';
    else {
      await aplicarRegla(U, nivel, asig, m.regla, m.tc);
      const secs = await q<any>('SELECT id, nivel, asignatura_id FROM {S}.secciones WHERE usuario_id=? AND nivel=? AND asignatura_id=?', [U, nivel, asig]);
      let n = 0;
      for (const s of secs) n += (await crearEvaluacionesPlan(U, s, m.regla, m.tc)).length;
      msg = `Se aplicaron los componentes del MEP: ${resumenRegla(m.regla)}.` + (n ? ' Se crearon las pruebas y proyectos que faltaban en sus secciones.' : ' Las evaluaciones que ya tenía no se cambiaron.');
    }
  } else if (accion === 'unir') {
    // Pasa las evaluaciones de un componente anterior (sin columna SEA) a uno de los fijos y lo elimina
    const viejo = await one<any>('SELECT * FROM {S}.componentes WHERE id=? AND usuario_id=? AND clave IS NULL', [num(f.get('id')), U]);
    const destino = await one<any>('SELECT * FROM {S}.componentes WHERE id=? AND usuario_id=? AND nivel=? AND COALESCE(asignatura_id,0)=COALESCE(?::int,0) AND clave IS NOT NULL', [num(f.get('destino')), U, viejo?.nivel ?? '', viejo?.asignatura_id ?? null]);
    if (viejo && destino) {
      const esquema = esquemaActual();
      await transaccion(async (c) => {
        await c.query(preparar('UPDATE {S}.evaluaciones SET componente_id=? WHERE componente_id=?', esquema), [destino.id, viejo.id]);
        await c.query(preparar('DELETE FROM {S}.componentes WHERE id=?', esquema), [viejo.id]);
      });
      msg = `Las evaluaciones de «${viejo.nombre}» ahora están en ${destino.nombre}.`;
    }
  } else if (accion === 'borrar') {
    await exec('DELETE FROM {S}.componentes WHERE id=? AND usuario_id=? AND clave IS NULL', [num(f.get('id')), U]);
  }
}
if (nivel) await asegurarComponentes(U, nivel, asig || null);
const comps = nivel ? await q<any>(`SELECT c.*, (SELECT COUNT(*) FROM {S}.evaluaciones e WHERE e.componente_id=c.id) AS evals
  FROM {S}.componentes c WHERE usuario_id=? AND nivel=? AND COALESCE(asignatura_id,0)=? ORDER BY clave IS NULL, orden, id`, [U, nivel, asig]) : [];
const mep = asig ? await reglaDeMateria(U, asig) : null;
const actual = combos.find((c) => c.nivel === nivel && Number(c.asig) === asig);
const fijos = comps.filter((c) => c.clave);
const viejos = comps.filter((c) => !c.clave);
const suma = fijos.reduce((s, c) => s + Number(c.porcentaje), 0);
const TIPOS = { puntos: 'Por puntos', indicadores: 'Por indicadores (1-3)' };
---
<Base titulo="Componentes">
  <h1>Componentes de evaluación</h1>
  <p class="sub">Son las columnas de la plantilla del SEA. Cada nivel y materia tiene los suyos en {inst!.nombre}; si la materia tiene tipo del MEP, se crean con los porcentajes del reglamento. Las evaluaciones se reparten el porcentaje de su componente.</p>
  {msg && <div class="msg ok">{msg}</div>}{error && <div class="msg mal">{error}</div>}
  {avisos.length > 0 && <div class="msg aviso">{avisos.map((a) => <div>{a}</div>)}</div>}
  <form method="get" class="tarjeta fila">
    <label>Nivel y materia
      <select onchange="const [n, a] = this.value.split('|'); location.href = '?nivel=' + encodeURIComponent(n) + '&asignatura=' + a">
        {combos.length === 0 && <option value="">Cree secciones primero</option>}
        {combos.map((c) => <option value={clave(c.nivel, Number(c.asig))} selected={c.nivel === nivel && Number(c.asig) === asig}>{etiqueta(c)}</option>)}
      </select>
    </label>
  </form>
  {nivel && (
    <div class="tarjeta mep">
      {mep ? (
        <form method="post" class="fila">
          <input type="hidden" name="accion" value="mep" /><input type="hidden" name="nivel" value={nivel} /><input type="hidden" name="asignatura" value={asig} />
          <span style="flex:1"><b>Reglamento de Evaluación {mep.anio}, art. {mep.regla.articulo}:</b> {mep.regla.nombre}.<br /><span class="muted">{resumenRegla(mep.regla)}</span></span>
          <button class="sec" onclick="return confirm('Se ponen los porcentajes del reglamento y se crean las pruebas que falten. Las evaluaciones que ya tiene no se borran. ¿Continuar?')">Aplicar componentes del MEP</button>
        </form>
      ) : <p class="muted" style="margin:0">{asig ? <>Esta materia no tiene tipo del MEP. Elíjalo en <a href="/ajustes#materias">Ajustes → Mis materias</a> para aplicar los porcentajes del reglamento con un toque.</> : 'Las secciones sin materia usan estos componentes. Asigne una materia a la sección para usar los del reglamento.'}</p>}
    </div>
  )}
  {nivel && (
    <>
      {suma !== 100 && !(mep?.regla.diagnostico) && <div class="msg aviso">Los componentes de {actual ? etiqueta(actual) : nivel} suman {suma}%. Deben sumar 100%.</div>}
      {mep?.regla.diagnostico && <div class="msg aviso">Según el reglamento, esta materia tiene carácter diagnóstico y formativo: sus componentes no llevan porcentaje.</div>}
      <form method="post" class="tabla">
        <input type="hidden" name="accion" value="guardar" /><input type="hidden" name="nivel" value={nivel} /><input type="hidden" name="asignatura" value={asig} />
        <table>
          <tr><th>Componente (columna del SEA)</th><th class="n">Porcentaje</th><th>Se califica</th><th class="n">Evaluaciones</th></tr>
          {fijos.map((c) => (<>
            <tr><td><input type="hidden" name="id" value={c.id} /><b>{c.nombre}</b></td>
              <td class="n"><input name="porcentaje" value={Number(c.porcentaje)} inputmode="decimal" style="width:80px;text-align:right" /></td>
              <td>{c.clave === 'asistencia'
                ? <><input type="hidden" name="tipo" value="asistencia" /><span class="muted">Automático, según la asistencia</span></>
                : <select name="tipo">{Object.entries(TIPOS).map(([k, v]) => <option value={k} selected={c.tipo === k}>{v}</option>)}</select>}</td>
              <td class="n">{c.evals}</td></tr>
            {c.clave === 'prueba' && (
              <tr><td colspan="4" style="background:var(--hielo)">
                <input type="hidden" name="prueba_id" value={c.id} />
                <label style="flex-direction:row;align-items:center;gap:8px;flex-wrap:wrap;color:var(--tinta);font-size:14px">
                  En el II periodo, la I prueba vale
                  <input name="prueba1" value={c.prueba1 !== null ? Number(c.prueba1) : PRUEBA1_DEFECTO} inputmode="decimal" style="width:70px;text-align:right" /> %
                  <span class="muted">y la II (la que se exime) {Math.round((Number(c.porcentaje) - Number(c.prueba1 ?? PRUEBA1_DEFECTO)) * 100) / 100} %. El SEA trae solo la nota de la I prueba.</span>
                </label></td></tr>
            )}
          </>))}
          <tr><th>Total</th><th class="n">{suma}%</th><th colspan="2"></th></tr>
        </table>
        <p style="padding:0 10px"><button>Guardar porcentajes</button></p>
      </form>
      {combos.length > 1 && (
        <form method="post" class="fila" style="margin-top:12px"><input type="hidden" name="accion" value="copiar" /><input type="hidden" name="nivel" value={nivel} /><input type="hidden" name="asignatura" value={asig} />
          <label>Copiar estos porcentajes a<select name="destino">{combos.filter((c) => !(c.nivel === nivel && Number(c.asig) === asig)).map((c) => <option value={clave(c.nivel, Number(c.asig))}>{etiqueta(c)}</option>)}</select></label><button class="sec">Copiar</button></form>
      )}
      {viejos.length > 0 && (
        <div class="tarjeta" style="margin-top:20px">
          <h2 style="margin-top:0">Componentes anteriores</h2>
          <p class="muted">Se crearon antes de usar la plantilla del SEA y no se exportan. Pase sus evaluaciones a uno de los componentes fijos, o elimínelos si están vacíos.</p>
          <div class="tabla"><table>
            <tr><th>Componente</th><th class="n">Evaluaciones</th><th>Pasar evaluaciones a</th><th></th></tr>
            {viejos.map((c) => (
              <tr><td>{c.nombre}</td><td class="n">{c.evals}</td>
                <td><form method="post" class="fila"><input type="hidden" name="accion" value="unir" /><input type="hidden" name="nivel" value={nivel} /><input type="hidden" name="asignatura" value={asig} /><input type="hidden" name="id" value={c.id} />
                  <select name="destino">{fijos.filter((x) => x.clave !== 'asistencia').map((x) => <option value={x.id}>{x.nombre}</option>)}</select><button class="mini sec">Pasar</button></form></td>
                <td><form method="post" onsubmit="return confirm('¿Eliminar este componente y sus evaluaciones?')"><input type="hidden" name="accion" value="borrar" /><input type="hidden" name="nivel" value={nivel} /><input type="hidden" name="asignatura" value={asig} /><input type="hidden" name="id" value={c.id} /><button class="mini peligro">Eliminar</button></form></td></tr>
            ))}
          </table></div>
        </div>
      )}
    </>
  )}
</Base>
