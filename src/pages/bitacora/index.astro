---
// Bitácora de una sección: minuta del día, anotaciones sobre estudiantes, comunicados enviados
// (registrados solos) e historial. Solo la ve el docente que la escribe.
import Base from '../../layouts/Base.astro';
import MinutaEditor from '../../components/MinutaEditor.astro';
import BuscarEstudiante from '../../components/BuscarEstudiante.astro';
import { q } from '../../lib/db';
import { estudiantesDe } from '../../lib/calc';
import { hoy, etiquetaSeccion } from '../../lib/util';
import { bitacoraRango, horaCorta } from '../../lib/bitacora';
import { planDeSeccion, temasDe, avanceDe, estadoPlan, revisarAtrasos } from '../../lib/plan';
const { user } = Astro.locals;
const sp = Astro.url.searchParams;
const secciones = await q<any>(`SELECT s.id, s.nivel, s.nombre, s.subgrupo, a.nombre AS asignatura FROM {S}.secciones s
  LEFT JOIN general.asignaturas a ON a.id=s.asignatura_id WHERE s.usuario_id=? ORDER BY length(s.nivel), s.nivel, s.nombre, s.subgrupo NULLS FIRST`, [user.id]);
const pedida = Number(sp.get('seccion') ?? Astro.cookies.get('rd_bit')?.value ?? 0);
const sec = secciones.find((s) => s.id === pedida) ?? secciones[0];
const fecha = /^\d{4}-\d{2}-\d{2}$/.test(sp.get('fecha') ?? '') ? sp.get('fecha')! : hoy();
if (sec) Astro.cookies.set('rd_bit', String(sec.id), { path: '/', sameSite: 'lax', maxAge: 400 * 86400 });
// Plan anual de la sección: revisa atrasos (quedan en la bitácora) antes de leer el día
if (sec) await revisarAtrasos(user.id, hoy());
const plan = sec ? await planDeSeccion(user.id, sec.id) : undefined;
const planTemas = plan ? await temasDe(plan.id) : [];
const planAvance = sec && plan ? await avanceDe(sec.id) : new Map<number, string>();
const planEst = estadoPlan(planTemas, planAvance, fecha, plan?.tolerancia ?? 7);
// Temas para marcar: atrasados, los que corresponden a este día, los vistos este día y el siguiente
const marcables = planTemas.filter((t) => {
  const e = planEst.estado.get(t.id);
  return e === 'atrasado' || e === 'encurso' || planAvance.get(t.id) === fecha || t.id === planEst.proximo?.id;
}).slice(0, 12);
const dia = sec ? (await bitacoraRango(user.id, sec.id, fecha, fecha))[0] : undefined;
const ests = sec ? (await estudiantesDe(sec.id)).map((e) => ({ id: e.id, nombre: `${e.nombre} ${e.apellidos}` })) : [];
// Historial: días con algo registrado en los últimos 60 días
const desde60 = new Date(new Date(fecha + 'T12:00:00').getTime() - 60 * 86400000).toISOString().slice(0, 10);
const historial = sec ? (await bitacoraRango(user.id, sec.id, desde60, hoy())).filter((d) => d.fecha !== fecha) : [];
const fechaTexto = (f: string) => { const t = new Date(f + 'T12:00:00').toLocaleDateString('es-CR', { weekday: 'long', day: 'numeric', month: 'long' }); return t.charAt(0).toUpperCase() + t.slice(1); };
const MEDIO: Record<string, string> = { whatsapp: 'WhatsApp', impreso: 'Impreso', ambos: 'WhatsApp e impreso' };
const TIPO: Record<string, string> = { ausencia: 'Ausencia', tardia: 'Tardía', no_entrego: 'No entregó', alerta: 'Alerta de ausentismo', eximido: 'Eximido', libre: 'Mensaje general', hogar: 'Comunicado al hogar' };
const extracto = (t: string, n = 140) => (t.length > n ? t.slice(0, n).trimEnd() + '…' : t);
const titulo = (t: string) => t.toLowerCase().replace(/(^|[\s-])(\p{L})/gu, (m, x, y) => x + y.toUpperCase());
const inicioMes = fecha.slice(0, 8) + '01';
---
<Base titulo="Bitácora">
  <h1>Bitácora</h1>
  <p class="sub">Minuta de cada clase y anotaciones sobre estudiantes. Se guarda sola; los comunicados enviados quedan registrados aquí.</p>
  {!sec ? <div class="msg aviso">Primero cree una sección.</div> : (
    <>
      <form method="get" class="tarjeta fila">
        <label>Sección<select name="seccion" onchange="this.form.submit()">{secciones.map((s) => <option value={s.id} selected={s.id === sec.id}>{etiquetaSeccion(s)}{s.asignatura ? ` · ${s.asignatura}` : ''}</option>)}</select></label>
        <label>Día<input type="date" name="fecha" value={fecha} max={hoy()} onchange="this.form.submit()" /></label>
        {fecha !== hoy() && <a class="btn sec" href={`?seccion=${sec.id}`}>Ir a hoy</a>}
      </form>

      <h2>{fechaTexto(fecha)}</h2>
      <MinutaEditor seccionId={sec.id} fecha={fecha} tipo="minuta" titulo="Minuta de la clase" anotacion={dia?.minuta ?? null} estudiantes={ests} filas={6} />

      {plan && planTemas.length > 0 && (
        <section class="plan-dia" data-seccion={sec.id} data-fecha={fecha}>
          <div class="pd-cab">
            <h3>Plan anual</h3>
            <span class={planEst.atrasados.length ? 'mal-txt' : 'ok-txt'}>{planEst.atrasados.length ? `${planEst.atrasados.length} ${planEst.atrasados.length === 1 ? 'tema atrasado' : 'temas atrasados'}` : 'Al día'}</span>
            <span class="muted">{planEst.vistos}/{planEst.total} vistos</span>
            <a class="pd-ver" href={`/plan/${plan.id}?seccion=${sec.id}`}>Ver plan</a>
          </div>
          <p class="muted pd-ayuda">Marque los temas que vio en esta clase:</p>
          <ul class="pd-temas">
            {marcables.map((t) => {
              const e = planEst.estado.get(t.id);
              return <li class={`e-${e}`}><label><input type="checkbox" data-tema={t.id} checked={planAvance.has(t.id)} />
                <span>{t.tema}<small class="muted">{t.unidad && `${t.unidad} · `}{e === 'atrasado' ? 'pasó su fecha' : e === 'encurso' ? 'corresponde ahora' : e === 'visto' ? 'visto' : 'siguiente'}</small></span></label></li>;
            })}
          </ul>
          {[...(dia?.plan ?? [])].sort((a, b) => a.id - b.id).map((n) => (
            <MinutaEditor seccionId={sec.id} fecha={fecha} tipo="plan" anotacion={n} estudiantes={ests} filas={6} titulo={n.texto.startsWith('Se recuperó') ? 'Plan al día' : 'Atraso en el plan: escriba la causa'} />
          ))}
        </section>
      )}

      <h3 class="sub-t">Anotaciones sobre estudiantes</h3>
      <div class="notas">
        {(dia?.notas ?? []).length === 0 && <p class="muted">Sin anotaciones este día.</p>}
        {(dia?.notas ?? []).map((n) => (
          <details class="nota" data-contenedor>
            <summary>
              <b>{n.estudiantes.map((e) => titulo(e.nombre)).join(', ') || 'Sin estudiante'}</b>
              <span class="n-extracto muted">{extracto(n.texto, 90)}</span>
              <span class="n-hora muted">{horaCorta(n.actualizado)}</span>
            </summary>
            <MinutaEditor seccionId={sec.id} fecha={fecha} tipo="estudiante" anotacion={n} estudiantes={ests} filas={3} borrable />
          </details>
        ))}
        <details class="nota nueva" id="nueva-nota">
          <summary class="btn">+ Nueva anotación</summary>
          <MinutaEditor seccionId={sec.id} fecha={fecha} tipo="estudiante" estudiantes={ests} filas={3} placeholder="Anotación sobre uno o varios estudiantes. Elíjalos con «+ Estudiante» o escriba @." ayudaVoz />
        </details>
        <p id="otra" hidden><a class="btn sec" href={`?seccion=${sec.id}&fecha=${fecha}`}>Agregar otra anotación</a></p>
      </div>

      <h3 class="sub-t">Comunicados del día</h3>
      <div class="com-uno"><BuscarEstudiante etiqueta="Comunicado a un estudiante" placeholder="Escriba el nombre del estudiante" estudiantes={ests.map((e) => ({ id: e.id, nombre: e.nombre, sid: sec.id, seccion: etiquetaSeccion(sec) }))} /></div>
      {(dia?.comunicados ?? []).length === 0 ? <p class="muted">No se enviaron comunicados este día.</p> : (
        <ul class="comunicados">
          {dia!.comunicados.map((c) => (
            <li><span class={`chip ${c.medio === 'whatsapp' ? 'ok' : 'aviso'}`}>{MEDIO[c.medio] ?? c.medio}</span>
              <b>{c.estudiante ? <a href={`/estudiantes/${c.estudiante_id}`}>{c.estudiante}</a> : 'Grupo'}</b>
              <span class="muted">{TIPO[c.tipo] ?? c.tipo} · {horaCorta(c.creado)}</span>
              <div class="msg-txt">{extracto(c.mensaje, 220)}</div></li>
          ))}
        </ul>
      )}

      <div class="tarjeta imprimir">
        <h3 style="margin-top:0">Imprimir resumen</h3>
        <form method="get" action="/bitacora/imprimir" class="fila">
          <input type="hidden" name="seccion" value={sec.id} />
          <label>Desde<input type="date" name="desde" value={inicioMes} /></label>
          <label>Hasta<input type="date" name="hasta" value={fecha} /></label>
          <button>Ver resumen</button>
        </form>
      </div>

      <h3 class="sub-t">Días anteriores</h3>
      {historial.length === 0 ? <p class="muted">Aún no hay días anteriores con registros (últimos 60 días).</p> : (
        <ul class="historial">
          {historial.map((d) => (
            <li><a href={`?seccion=${sec.id}&fecha=${d.fecha}`}><b>{fechaTexto(d.fecha)}</b></a>
              <span class="muted">{[d.minuta?.texto ? 'minuta' : '', d.notas.length ? `${d.notas.length} ${d.notas.length === 1 ? 'anotación' : 'anotaciones'}` : '', d.comunicados.length ? `${d.comunicados.length} ${d.comunicados.length === 1 ? 'comunicado' : 'comunicados'}` : '', d.temas.length ? `${d.temas.length} ${d.temas.length === 1 ? 'tema del plan' : 'temas del plan'}` : '', d.plan.length ? 'plan anual' : ''].filter(Boolean).join(' · ')}</span>
              {d.minuta?.texto && <div class="msg-txt">{extracto(d.minuta.texto)}</div>}</li>
          ))}
        </ul>
      )}
    </>
  )}
  <script is:inline>
    // Al guardarse la «Nueva anotación» queda creada: se ofrece agregar otra
    document.getElementById('nueva-nota')?.addEventListener('minuta:creada', () => { document.getElementById('otra').hidden = false; });
    // Temas del plan vistos en esta clase
    document.querySelectorAll('.plan-dia input[data-tema]').forEach((c) => c.addEventListener('change', async () => {
      const caja = c.closest('.plan-dia');
      const r = await fetch('/api/plan-avance', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ seccion_id: Number(caja.dataset.seccion), tema_id: Number(c.dataset.tema), visto: c.checked, fecha: caja.dataset.fecha }) });
      if (!r.ok) { c.checked = !c.checked; alert('No se pudo guardar.'); }
    }));
    // Al abrir una anotación, el cursor queda al final del texto
    document.querySelectorAll('details.nota').forEach((d) => d.addEventListener('toggle', () => { if (d.open) { const t = d.querySelector('.m-texto'); t.focus(); t.setSelectionRange(t.value.length, t.value.length); } }));
  </script>
  <style>
    .sub-t { font-size: 16px; color: var(--marino); margin: 26px 0 10px; }
    .comunicados, .historial { list-style: none; margin: 0; padding: 0; background: #fff; border: 1px solid var(--linea); border-radius: 12px; }
    .comunicados li, .historial li { padding: 10px 14px; border-top: 1px solid var(--linea); display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
    .comunicados li:first-child, .historial li:first-child { border-top: 0; }
    .msg-txt { flex-basis: 100%; color: var(--tinta); font-size: 14px; white-space: pre-wrap; }
    .imprimir { margin-top: 24px; }
    .com-uno { margin-bottom: 10px; }
    .plan-dia { background: #fff; border: 1px solid var(--linea); border-left: 4px solid var(--marino); border-radius: 12px; padding: 12px 16px; margin-top: 16px; }
    .pd-cab { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
    .pd-cab h3 { margin: 0; font-size: 16px; color: var(--marino); }
    .pd-ver { margin-left: auto; font-size: 14px; }
    .pd-ayuda { margin: 6px 0; font-size: 13.5px; }
    .pd-temas { list-style: none; margin: 0 0 6px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 4px 16px; }
    .pd-temas label { display: flex; flex-direction: row; gap: 8px; align-items: flex-start; cursor: pointer; font-size: 14px; padding: 4px 0; }
    .pd-temas input { width: 18px; height: 18px; flex: none; margin-top: 1px; }
    .pd-temas small { display: block; font-size: 12px; }
    .pd-temas .e-atrasado small { color: var(--rojo); }
    .plan-dia :global(.minuta) { margin-top: 10px; border-color: #f0c9c9; }
    .ok-txt { color: var(--verde); } .mal-txt { color: var(--rojo); }
    .notas { display: flex; flex-direction: column; gap: 8px; }
    details.nota:not(.nueva) { background: #fff; border: 1px solid var(--linea); border-radius: 12px; }
    details.nota:not(.nueva) > summary { display: flex; gap: 12px; align-items: baseline; padding: 11px 16px; cursor: pointer; list-style: none; }
    details.nota > summary::-webkit-details-marker { display: none; }
    details.nota:not(.nueva) > summary::before { content: '▸'; color: var(--teal); flex: none; }
    details.nota[open]:not(.nueva) > summary::before { content: '▾'; }
    details.nota:not(.nueva) > summary b { flex: none; color: var(--marino); }
    .n-extracto { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    details.nota[open] .n-extracto { visibility: hidden; }
    .n-hora { flex: none; font-size: 13px; }
    details.nota:not(.nueva) > :global(.minuta) { border: 0; margin: 0; padding: 0 16px 14px; }
    details.nota.nueva > summary { list-style: none; display: inline-block; cursor: pointer; }
    details.nota.nueva[open] > summary { margin-bottom: 8px; }
    @media (max-width: 700px) { details.nota:not(.nueva) > summary { flex-wrap: wrap; } .n-extracto { flex-basis: 100%; order: 3; } }
  </style>
</Base>
