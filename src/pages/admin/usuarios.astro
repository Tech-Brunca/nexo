---
import Base from '../../layouts/Base.astro';
import { exec, q } from '../../lib/db';
import { hashClave, claveValida } from '../../lib/auth';
import { num, str } from '../../lib/util';
import { colegiosDe, resetearColegio, resetearTodo, eliminarCuenta } from '../../lib/admin';
const { user } = Astro.locals;
let msg = '', error = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = str(f.get('accion'));
  const id = num(f.get('id'));
  if (id === user.id && accion !== 'clave') error = 'No puede cambiar el estado ni el rol de su propia cuenta.';
  else if (accion === 'aprobar') { await exec(`UPDATE general.usuarios SET estado='activo' WHERE id=?`, [id]); msg = 'Cuenta aprobada.'; }
  else if (accion === 'bloquear') { await exec(`UPDATE general.usuarios SET estado='bloqueado' WHERE id=?`, [id]); msg = 'Cuenta desactivada.'; }
  else if (accion === 'rol') { await exec('UPDATE general.usuarios SET rol=? WHERE id=?', [str(f.get('rol')) === 'admin' ? 'admin' : 'docente', id]); msg = 'Rol actualizado.'; }
  else if (accion === 'rechazar') { await exec(`DELETE FROM general.usuarios WHERE id=? AND estado='pendiente'`, [id]); msg = 'Solicitud rechazada.'; }
  else if (accion === 'resetear-colegio' || accion === 'resetear-todo' || accion === 'eliminar') {
    // Borrados que no se pueden deshacer: se confirma escribiendo la palabra
    const palabra = accion === 'eliminar' ? 'ELIMINAR' : 'RESETEAR';
    if (str(f.get('confirmar')).toUpperCase() !== palabra) error = `Para confirmar escriba ${palabra}.`;
    else {
      try {
        msg = accion === 'resetear-colegio' ? await resetearColegio(id, num(f.get('colegio')))
          : accion === 'resetear-todo' ? await resetearTodo(id) : await eliminarCuenta(id);
      } catch (e: any) { error = `No se pudo completar: ${e.message}`; }
    }
  }
  else if (accion === 'clave') {
    const c = str(f.get('clave'));
    if (!claveValida(c)) error = 'La contraseña temporal debe tener al menos 8 caracteres.';
    else { await exec('UPDATE general.usuarios SET pass_hash=? WHERE id=?', [await hashClave(c), id]); msg = 'Contraseña temporal asignada. Pida al docente cambiarla en «Mi cuenta».'; }
  }
}
const filtro = Astro.url.searchParams.get('estado') ?? '';
const usuarios = await q<any>(`SELECT u.*, string_agg(c.nombre, ', ' ORDER BY c.nombre) AS instituciones, COUNT(c.id) AS colegios
  FROM general.usuarios u LEFT JOIN general.usuario_colegios uc ON uc.usuario_id=u.id LEFT JOIN general.colegios c ON c.id=uc.colegio_id
  WHERE (?='' OR u.estado=?) GROUP BY u.id
  ORDER BY CASE u.estado WHEN 'pendiente' THEN 0 WHEN 'activo' THEN 1 ELSE 2 END, u.nombre`, [filtro, filtro]);
const colegiosPor = new Map(await Promise.all(usuarios.map(async (u) => [u.id, await colegiosDe(u.id)] as const)));
const pendientes = usuarios.filter((u) => u.estado === 'pendiente').length;
const chip = { pendiente: 'aviso', activo: 'ok', bloqueado: 'mal' } as Record<string, string>;
---
<Base titulo="Usuarios">
  <h1>Usuarios</h1>
  <p class="sub">Apruebe las solicitudes de acceso y administre las cuentas. Para borrar los datos de un docente y que empiece de cero, use «Resetear datos» en su fila.{pendientes > 0 && ` Hay ${pendientes} pendiente(s).`}</p>
  {msg && <div class="msg ok">{msg}</div>}{error && <div class="msg mal">{error}</div>}
  <form class="fila" style="margin-bottom:12px"><label>Mostrar<select name="estado" onchange="this.form.submit()">
    {[['', 'Todos'], ['pendiente', 'Pendientes'], ['activo', 'Activos'], ['bloqueado', 'Desactivados']].map(([v, t]) => <option value={v} selected={v === filtro}>{t}</option>)}
  </select></label></form>
  <div class="tabla"><table>
    <tr><th>Docente</th><th>Colegios / nota</th><th>Estado</th><th>Rol</th><th class="n">Colegios</th><th>Último acceso</th><th></th></tr>
    {usuarios.map((u) => (
      <tr>
        <td><b>{u.nombre}</b><br /><span class="muted">{u.correo}{u.cedula && ` · ${u.cedula}`}</span></td>
        <td>{u.instituciones ?? <span class="muted">{u.nota_registro || '—'}</span>}</td>
        <td><span class={`chip ${chip[u.estado]}`}>{u.estado}</span></td>
        <td>{u.id === user.id ? u.rol : (
          <form method="post"><input type="hidden" name="accion" value="rol" /><input type="hidden" name="id" value={u.id} />
            <select name="rol" onchange="this.form.submit()"><option value="docente" selected={u.rol === 'docente'}>docente</option><option value="admin" selected={u.rol === 'admin'}>admin</option></select></form>
        )}</td>
        <td class="n">{u.colegios}</td>
        <td class="muted">{u.ultimo_acceso ?? 'nunca'}</td>
        <td style="white-space:nowrap;text-align:right">
          {u.id !== user.id && u.estado !== 'activo' && <form method="post" style="display:inline"><input type="hidden" name="accion" value="aprobar" /><input type="hidden" name="id" value={u.id} /><button class="mini">{u.estado === 'pendiente' ? 'Aprobar' : 'Reactivar'}</button></form>}
          {u.id !== user.id && u.estado === 'activo' && <form method="post" style="display:inline" onsubmit="return confirm('¿Desactivar esta cuenta? Sus datos se conservan.')"><input type="hidden" name="accion" value="bloquear" /><input type="hidden" name="id" value={u.id} /><button class="mini peligro">Desactivar</button></form>}
          {u.estado === 'pendiente' && <form method="post" style="display:inline" onsubmit="return confirm('¿Rechazar y borrar la solicitud?')"><input type="hidden" name="accion" value="rechazar" /><input type="hidden" name="id" value={u.id} /> <button class="mini peligro">Rechazar</button></form>}
          {u.id !== user.id && u.estado !== 'pendiente' && (
            <details class="resetear"><summary class="btn-sum peligro-sum">Resetear datos</summary>
              <div class="r-panel">
                <p class="muted">No se puede deshacer. Pida antes al docente descargar su <b>Respaldo</b> (menú de su cuenta).</p>
                {(colegiosPor.get(u.id) ?? []).length > 0 && (
                  <form method="post" class="fila" onsubmit="return confirm('¿Borrar los datos del docente en ese colegio?')">
                    <input type="hidden" name="accion" value="resetear-colegio" /><input type="hidden" name="id" value={u.id} />
                    <label>Borrar sus datos de<select name="colegio">{colegiosPor.get(u.id)!.map((c) => <option value={c.id}>{c.nombre}</option>)}</select></label>
                    <input name="confirmar" placeholder="Escriba RESETEAR" autocomplete="off" style="width:150px" /><button class="mini peligro">Borrar del colegio</button>
                    <span class="muted r-ayuda">Secciones, estudiantes, notas, asistencia, bitácora y planes de ese colegio. Sus materias y los otros colegios quedan.</span>
                  </form>
                )}
                <form method="post" class="fila" onsubmit="return confirm('¿Borrar todos los datos del docente?')">
                  <input type="hidden" name="accion" value="resetear-todo" /><input type="hidden" name="id" value={u.id} />
                  <input name="confirmar" placeholder="Escriba RESETEAR" autocomplete="off" style="width:150px" /><button class="mini peligro">Borrar todos sus datos</button>
                  <span class="muted r-ayuda">Todo, en todos sus colegios, más sus materias, ajustes y plantillas. La cuenta y la contraseña quedan.</span>
                </form>
                <form method="post" class="fila" onsubmit="return confirm('¿Eliminar la cuenta y todos sus datos?')">
                  <input type="hidden" name="accion" value="eliminar" /><input type="hidden" name="id" value={u.id} />
                  <input name="confirmar" placeholder="Escriba ELIMINAR" autocomplete="off" style="width:150px" /><button class="mini peligro">Eliminar cuenta</button>
                  <span class="muted r-ayuda">Como si nunca se hubiera registrado.</span>
                </form>
              </div>
            </details>
          )}
          {u.estado !== 'pendiente' && (
            <details style="display:inline-block"><summary class="btn-sum">Clave</summary>
              <form method="post" class="fila" style="margin-top:6px"><input type="hidden" name="accion" value="clave" /><input type="hidden" name="id" value={u.id} />
                <input name="clave" placeholder="temporal (8+)" minlength="8" style="width:130px" /><button class="mini sec">Asignar</button></form>
            </details>
          )}
        </td>
      </tr>
    ))}
  </table></div>
  <style>
    details.resetear { display: inline-block; margin: 0 10px 0 12px; text-align: left; }
    .btn-sum { cursor: pointer; list-style: none; display: inline-block; padding: 4px 10px; border-radius: 8px; font-size: 13px; font-weight: 600;
      border: 1px solid var(--linea); background: #fff; color: var(--marino); }
    .btn-sum::-webkit-details-marker { display: none; }
    .btn-sum:hover, details[open] > .btn-sum { background: var(--hielo); }
    .peligro-sum { color: var(--rojo); border-color: #e9b9b0; }
    .peligro-sum:hover, details[open] > .peligro-sum { background: var(--rojo-claro); }
    .r-panel { position: absolute; right: 24px; z-index: 5; width: min(560px, 88vw); white-space: normal; background: #fff; border: 1px solid var(--linea);
      border-radius: 12px; padding: 12px 14px; box-shadow: 0 12px 30px rgba(3,18,48,.18); display: flex; flex-direction: column; gap: 10px; }
    .r-panel p { margin: 0; font-size: 13.5px; }
    .r-panel form { align-items: center; padding-top: 10px; border-top: 1px solid var(--linea); }
    .r-panel label { display: flex; flex-direction: column; gap: 3px; font-size: 13px; }
    .r-ayuda { flex-basis: 100%; font-size: 12.5px; }
  </style>
  <p class="muted">Los administradores ven esta lista y los colegios, pero no las notas ni los estudiantes de otros docentes.</p>
</Base>
