---
import Base from '../../layouts/Base.astro';
import { exec, q, one } from '../../lib/db';
import { num, str } from '../../lib/util';
let msg = '', error = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = str(f.get('accion'));
  const id = num(f.get('id'));
  if (accion === 'guardar') {
    if (!str(f.get('nombre'))) error = 'El nombre es obligatorio.';
    else {
      const datos = [str(f.get('nombre')), str(f.get('codigo')), str(f.get('direccion_regional')), str(f.get('circuito')), str(f.get('director'))];
      if (id) await exec('UPDATE instituciones SET nombre=?, codigo=?, direccion_regional=?, circuito=?, director=? WHERE id=?', [...datos, id]);
      else await exec('INSERT INTO instituciones (nombre, codigo, direccion_regional, circuito, director) VALUES (?,?,?,?,?)', datos);
      msg = 'Institución guardada.';
    }
  } else if (accion === 'borrar') {
    const uso = await one<any>('SELECT (SELECT COUNT(*) FROM secciones WHERE institucion_id=?) s, (SELECT COUNT(*) FROM usuario_instituciones WHERE institucion_id=?) u', [id, id]);
    if (uso.s > 0 || uso.u > 0) error = 'Esa institución tiene docentes o secciones asociadas; no se puede eliminar.';
    else { await exec('DELETE FROM instituciones WHERE id=?', [id]); msg = 'Institución eliminada.'; }
  }
}
const editar = Number(Astro.url.searchParams.get('editar') ?? 0);
const lista = await q<any>(`SELECT i.*, u.nombre AS creador,
  (SELECT COUNT(*) FROM usuario_instituciones ui WHERE ui.institucion_id=i.id) AS docentes,
  (SELECT COUNT(*) FROM secciones s WHERE s.institucion_id=i.id) AS secciones
  FROM instituciones i LEFT JOIN usuarios u ON u.id=i.creado_por ORDER BY i.nombre`);
const ed = lista.find((i) => i.id === editar) ?? { id: 0, nombre: '', codigo: '', direccion_regional: '', circuito: '', director: '' };
---
<Base titulo="Instituciones">
  <h1>Instituciones</h1>
  <p class="sub">Catálogo compartido. Los docentes eligen aquí las instituciones donde trabajan; corrija nombres duplicados o incompletos.</p>
  {msg && <div class="msg ok">{msg}</div>}{error && <div class="msg mal">{error}</div>}
  <form method="post" class="tarjeta fila">
    <input type="hidden" name="accion" value="guardar" /><input type="hidden" name="id" value={ed.id} />
    <label style="flex:2">Nombre<input name="nombre" value={ed.nombre} required /></label>
    <label>Código<input name="codigo" value={ed.codigo} size="8" /></label>
    <label style="flex:1">Dirección Regional<input name="direccion_regional" value={ed.direccion_regional} /></label>
    <label>Circuito<input name="circuito" value={ed.circuito} size="4" /></label>
    <label style="flex:1">Director(a)<input name="director" value={ed.director} /></label>
    <button>{ed.id ? 'Guardar cambios' : 'Agregar'}</button>{ed.id ? <a class="btn sec" href="/admin/instituciones">Cancelar</a> : null}
  </form>
  <div class="tabla"><table>
    <tr><th>Institución</th><th>Código</th><th>Regional</th><th>Circuito</th><th class="n">Docentes</th><th class="n">Secciones</th><th>Registrada por</th><th></th></tr>
    {lista.map((i) => (
      <tr><td><b>{i.nombre}</b></td><td>{i.codigo}</td><td>{i.direccion_regional}</td><td>{i.circuito}</td><td class="n">{i.docentes}</td><td class="n">{i.secciones}</td><td class="muted">{i.creador ?? '—'}</td>
        <td style="white-space:nowrap"><a href={`?editar=${i.id}`}>Editar</a>
          {i.docentes == 0 && i.secciones == 0 && <form method="post" style="display:inline" onsubmit="return confirm('¿Eliminar institución?')"><input type="hidden" name="accion" value="borrar" /><input type="hidden" name="id" value={i.id} /> <button class="mini peligro">×</button></form>}</td></tr>
    ))}
  </table></div>
</Base>
