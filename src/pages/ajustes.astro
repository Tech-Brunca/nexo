---
import Base from '../layouts/Base.astro';
import MateriaCampos from '../components/MateriaCampos.astro';
import { exec, q, one, getAjustes, getEscala } from '../lib/db';
import { CICLOS, anioVigente, reglasDe, resumenRegla } from '../lib/reac';
import { num, str } from '../lib/util';
const { user } = Astro.locals;
let ok = '', error = '';
const anioReglas = await anioVigente((await getAjustes(user.id)).curso_lectivo);
const reglas = await reglasDe(anioReglas);
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = str(f.get('accion'));
  await getAjustes(user.id);
  if (accion === 'reglas') {
    await exec('UPDATE general.ajustes SET curso_lectivo=?, nota_aprobatoria=?, tardias_por_ausencia=?, alerta_dias=?, alerta_ausencias=?, ne_cuenta_cero=? WHERE usuario_id=?',
      [num(f.get('curso_lectivo'), 2026), num(f.get('nota_aprobatoria'), 70), num(f.get('tardias_por_ausencia'), 2), num(f.get('alerta_dias'), 15), num(f.get('alerta_ausencias'), 3), str(f.get('ne_cuenta_cero')) !== 'no', user.id]);
    ok = 'Reglas guardadas.';
  } else if (accion === 'escala') {
    const desde = f.getAll('desde'), hasta = f.getAll('hasta'), pct = f.getAll('pct');
    await exec('DELETE FROM general.escala_asistencia WHERE usuario_id=?', [user.id]);
    for (let i = 0; i < desde.length; i++) {
      if (str(desde[i]) === '') continue;
      await exec('INSERT INTO general.escala_asistencia VALUES (?,?,?,?) ON CONFLICT DO NOTHING', [user.id, num(desde[i]), num(hasta[i]), num(pct[i])]);
    }
    ok = 'Escala de asistencia guardada.';
  } else if (accion === 'escala-mep') {
    // Al quedar vacía, getEscala vuelve a cargar la tabla del MEP
    await exec('DELETE FROM general.escala_asistencia WHERE usuario_id=?', [user.id]);
    ok = 'Se restauró la escala del MEP.';
  } else if (accion === 'asignatura' || accion === 'editar-asignatura') {
    // Materia con su ciclo y tipo del Reglamento de Evaluación: define los componentes que se crean solos
    const nombre = str(f.get('nombre')).slice(0, 120);
    const codigo = str(f.get('regla')) || null;
    const x = codigo ? reglas.find((r) => r.codigo === codigo) : null;
    const tc = str(f.get('tc_modo')) === 'unica' ? 'unica' : 'indicadores';
    if (!nombre) error = 'Escriba el nombre de la materia.';
    else if (accion === 'asignatura') {
      await exec('INSERT INTO general.asignaturas (usuario_id, nombre, ciclo, regla, tc_modo) VALUES (?,?,?,?,?)', [user.id, nombre, x?.ciclo ?? null, x?.codigo ?? null, tc]);
      ok = `Materia «${nombre}» agregada.${x ? ` Al crear sus secciones se crearán los componentes: ${resumenRegla(x)}.` : ''}`;
    } else {
      const id = num(f.get('id'));
      await exec('UPDATE general.asignaturas SET nombre=?, ciclo=?, regla=?, tc_modo=? WHERE id=? AND usuario_id=?', [nombre, x?.ciclo ?? null, x?.codigo ?? null, tc, id, user.id]);
      ok = `Materia «${nombre}» guardada.${x ? ' Para aplicar los porcentajes a secciones que ya existen, use Componentes.' : ''}`;
    }
  } else if (accion === 'borrar-asignatura') {
    const id = num(f.get('id'));
    const usada = Astro.locals.inst ? await one<any>('SELECT 1 FROM {S}.secciones WHERE usuario_id=? AND asignatura_id=? LIMIT 1', [user.id, id]) : null;
    if (usada) error = 'No se puede eliminar: hay secciones con esa materia en este colegio.';
    else {
      try {
        if (Astro.locals.inst) await exec('DELETE FROM {S}.componentes WHERE usuario_id=? AND asignatura_id=?', [user.id, id]);
        await exec('DELETE FROM general.asignaturas WHERE id=? AND usuario_id=?', [id, user.id]);
      } catch { error = 'No se puede eliminar: la materia se usa en otro de sus colegios.'; }
    }
  }
}
const c = await getAjustes(user.id);
const escala = await getEscala(user.id);
const asignaturas = await q<any>('SELECT * FROM general.asignaturas WHERE usuario_id=? ORDER BY nombre', [user.id]);
---
<Base titulo="Ajustes">
  <h1>Ajustes</h1>
  <p class="sub">Sus materias y reglas de evaluación. Aplican en todos sus colegios.</p>
  {ok && <div class="msg ok">{ok}</div>}{error && <div class="msg mal">{error}</div>}

  <div class="tarjeta" id="materias">
    <h2 style="margin-top:0">Mis materias</h2>
    <p class="muted">Elija el ciclo y el tipo de cada materia según el Reglamento de Evaluación ({anioReglas}): al crear una sección con esa materia, Nexo crea solos sus componentes con los porcentajes del MEP y reparte las pruebas en cada periodo.</p>
    {asignaturas.length === 0 && <p class="muted">Aún no hay materias.</p>}
    {asignaturas.length > 0 && (
      <ul class="materias">
        {asignaturas.map((a) => {
          const x = reglas.find((r) => r.codigo === a.regla);
          return (
            <li>
              <details>
                <summary><b>{a.nombre}</b> <span class="muted">{x ? `· ${CICLOS.find(([k]) => k === x.ciclo)?.[1].split(' (')[0]} · ${x.nombre}` : '· sin tipo del MEP'}</span>
                  {x && <span class="m-resumen">{resumenRegla(x)}{!x.diagnostico && ` · Trabajo cotidiano ${a.tc_modo === 'unica' ? 'con una sola nota' : 'por indicadores'}`}</span>}</summary>
                <form method="post" class="form-materia">
                  <input type="hidden" name="accion" value="editar-asignatura" /><input type="hidden" name="id" value={a.id} />
                  <MateriaCampos reglas={reglas} materia={a} />
                  <div class="fila"><button>Guardar</button></div>
                </form>
                <form method="post" class="fila" style="margin-top:6px">
                  <input type="hidden" name="accion" value="borrar-asignatura" /><input type="hidden" name="id" value={a.id} />
                  <button class="mini peligro" onclick="return confirm('¿Eliminar la materia?')">Eliminar materia</button>
                </form>
              </details>
            </li>
          );
        })}
      </ul>
    )}
    <p class="fila"><a class="btn" href="/asistente">+ Agregar materia con el asistente</a><span class="muted">Paso a paso: materia, sección y estudiantes.</span></p>
    <details class="nueva-materia">
      <summary class="muted" style="cursor:pointer">Agregar solo la materia, sin asistente</summary>
      <form method="post" class="form-materia">
        <input type="hidden" name="accion" value="asignatura" />
        <MateriaCampos reglas={reglas} />
        <div class="fila"><button>Agregar materia</button><span class="muted">Puede agregar o ajustar componentes después en Componentes.</span></div>
      </form>
    </details>
  </div>

  <form method="post" class="tarjeta">
    <input type="hidden" name="accion" value="reglas" />
    <h2 style="margin-top:0">Reglas</h2>
    <div class="fila">
      <label>Curso lectivo<input type="number" name="curso_lectivo" value={c.curso_lectivo} style="width:90px" /></label>
      <label>Nota aprobatoria<input type="number" step="0.01" name="nota_aprobatoria" value={c.nota_aprobatoria} style="width:90px" /></label>
      <label>Tardías que equivalen a 1 ausencia<input type="number" name="tardias_por_ausencia" value={c.tardias_por_ausencia} style="width:90px" /></label>
      <label>Alerta: días hacia atrás<input type="number" name="alerta_dias" value={c.alerta_dias} style="width:90px" /></label>
      <label>Alerta: lecciones ausentes desde<input type="number" name="alerta_ausencias" value={c.alerta_ausencias} style="width:90px" /></label>
      <label>En indicadores, «No entregó»
        <select name="ne_cuenta_cero"><option value="si" selected={c.ne_cuenta_cero}>cuenta como 0</option><option value="no" selected={!c.ne_cuenta_cero}>no se toma en cuenta</option></select>
      </label>
      <button>Guardar</button>
    </div>
  </form>

  <form method="post" class="tarjeta">
    <input type="hidden" name="accion" value="escala" />
    <h2 style="margin-top:0">Escala del componente de asistencia</h2>
    <p class="muted">Porcentaje de ausencias injustificadas del total de lecciones impartidas en el periodo (incluye las tardías convertidas) → porcentaje del valor del componente que obtiene el estudiante. Viene con la tabla del artículo 37 del Reglamento de Evaluación 2026: de 0 % a menos de 10 % de ausencias obtiene todo el valor; cada 10 % más baja una quinta parte, y desde 50 % obtiene 0. Con asistencia de 5 %: 5, 4, 3, 2, 1 y 0.</p>
    <table style="max-width:520px">
      <tr><th>Desde %</th><th>Hasta % (sin incluir)</th><th>Obtiene %</th></tr>
      {[...escala, { desde: '', hasta: '', porcentaje: '' }].map((e) => (
        <tr><td><input name="desde" value={e.desde} /></td><td><input name="hasta" value={e.hasta} /></td><td><input name="pct" value={e.porcentaje} /></td></tr>
      ))}
    </table>
    <p class="fila"><button>Guardar escala</button>
      <button class="sec" form="escala-mep" onclick="return confirm('¿Volver a la escala del MEP? Se pierden los cambios hechos a la escala.')">Restaurar escala del MEP</button></p>
  </form>
  <form id="escala-mep" method="post"><input type="hidden" name="accion" value="escala-mep" /></form>
  <style>
    .materias { list-style: none; margin: 0 0 12px; padding: 0; border: 1px solid var(--linea); border-radius: 10px; }
    .materias li { border-top: 1px solid var(--linea); padding: 10px 14px; }
    .materias li:first-child { border-top: 0; }
    .materias summary { cursor: pointer; }
    .m-resumen { display: block; font-size: 13px; color: var(--suave); margin-top: 2px; }
    .nueva-materia > summary { list-style: none; display: inline-block; cursor: pointer; }
    .nueva-materia > summary::-webkit-details-marker { display: none; }
    .nueva-materia[open] > summary { margin-bottom: 6px; }
  </style>
</Base>
