---
import Base from '../../layouts/Base.astro';
import { q } from '../../lib/db';
import { CATALOGO } from '../../lib/informes';
import { hoy, etiquetaSeccion, sqlEtiquetaSeccion } from '../../lib/util';
const { user } = Astro.locals;
const secciones = await q<any>(`SELECT s.id, s.nivel, s.nombre, s.subgrupo, a.nombre AS asignatura FROM {S}.secciones s LEFT JOIN general.asignaturas a ON a.id=s.asignatura_id
  WHERE s.usuario_id=? ORDER BY length(s.nivel), s.nivel, s.nombre, s.subgrupo NULLS FIRST`, [user.id]);
const periodos = await q<any>('SELECT id, nombre FROM {S}.periodos WHERE usuario_id=? ORDER BY numero', [user.id]);
const niveles = [...new Set(secciones.map((s) => s.nivel))];
const evaluaciones = await q<any>(`SELECT e.id, e.nombre, s.nivel, ${sqlEtiquetaSeccion()} AS seccion, p.nombre AS periodo FROM {S}.evaluaciones e
  JOIN {S}.secciones s ON s.id=e.seccion_id JOIN {S}.componentes c ON c.id=e.componente_id JOIN {S}.periodos p ON p.id=e.periodo_id
  WHERE s.usuario_id=? AND c.tipo='indicadores' ORDER BY e.fecha DESC NULLS LAST, e.id DESC LIMIT 200`, [user.id]);
// Pruebas del II periodo, para elegir cuál se exime
const pruebas2 = await q<any>(`SELECT e.id, e.nombre, e.seccion_id FROM {S}.evaluaciones e JOIN {S}.componentes c ON c.id=e.componente_id
  JOIN {S}.periodos p ON p.id=e.periodo_id JOIN {S}.secciones s ON s.id=e.seccion_id
  WHERE s.usuario_id=? AND c.clave='prueba' AND p.numero=2 ORDER BY e.fecha NULLS LAST, e.id`, [user.id]);
const estudiantes = await q<any>(`SELECT e.id, e.apellidos, e.nombre, m.seccion_id FROM {S}.estudiantes e JOIN {S}.matriculas m ON m.estudiante_id=e.id
  WHERE e.usuario_id=? AND e.activo=1 ORDER BY e.apellidos, e.nombre`, [user.id]);
---
<Base titulo="Informes">
  <h1>Informes</h1>
  <p class="sub">Para imprimir, guardar en PDF o abrir en Excel. Llevan el encabezado del MEP con los datos de su colegio.</p>
  {secciones.length === 0 && <div class="msg aviso">Primero cree una sección.</div>}
  <div class="grid-inf">
    {CATALOGO.map((c) => (
      <form method="get" action={`/informes/${c.tipo}`} class="tarjeta" target="_blank">
        <h2 style="margin-top:0">{c.titulo}</h2>
        <p class="muted" style="margin-top:-4px">{c.descripcion}</p>
        <div class="fila">
          {(c.pide.includes('seccion') || c.pide.includes('seccion_o_nivel')) && (
            <label>Sección<select name="seccion" class="sel-seccion" required={c.pide.includes('seccion')}>
              {c.pide.includes('seccion_o_nivel') && <option value="">—</option>}
              {secciones.map((s) => <option value={s.id}>{etiquetaSeccion(s)}{s.asignatura ? ` · ${s.asignatura}` : ''}</option>)}</select></label>
          )}
          {c.pide.includes('seccion_o_nivel') && <label>o todo el nivel<select name="nivel"><option value="">—</option>{niveles.map((n) => <option>{n}</option>)}</select></label>}
          {c.pide.includes('subgrupo') && <label>Subgrupo<input name="subgrupo" size="3" placeholder="todos" /></label>}
          {c.pide.includes('periodo') && <label>Periodo<select name="periodo">{!c.tipo.startsWith('calificaciones') && <option value="">Todo el curso</option>}{periodos.map((p) => <option value={p.id}>{p.nombre}</option>)}</select></label>}
          {c.pide.includes('fechas') && <><label>Desde<input type="date" name="desde" /></label><label>Hasta<input type="date" name="hasta" /></label></>}
          {c.pide.includes('estudiante') && (
            <label>Estudiante<select name="estudiante" class="sel-est"><option value="">Todo el grupo</option>
              {estudiantes.map((e) => <option value={e.id} data-sec={e.seccion_id}>{e.apellidos} {e.nombre}</option>)}</select></label>
          )}
          {c.pide.includes('examen') && (
            <label>Prueba que se exime<select name="excluir" class="sel-sec-dep"><option value="">La última prueba del II periodo</option>
              {pruebas2.map((e) => <option value={e.id} data-sec={e.seccion_id}>{e.nombre}</option>)}</select></label>
          )}
          {c.pide.includes('umbral') && <><label>Nota mínima (igual o mayor)<input type="number" name="umbral" value="90" min="0" max="100" style="width:80px" /></label><label style="flex-direction:row;align-items:center;gap:6px"><input type="checkbox" name="solo" value="1" /> Solo eximidos</label></>}
          {c.pide.includes('asunto') && <><label style="flex:1">Asunto<input name="asunto" /></label><label>Fecha<input type="date" name="fecha" value={hoy()} /></label></>}
          {c.pide.includes('dias') && <><label>Últimos días<input type="number" name="dias" style="width:80px" /></label><label>Lecciones desde<input type="number" name="min" style="width:80px" /></label></>}
          {c.pide.includes('evaluacion') && (
            <label style="flex:1">Evaluación<select name="evaluacion" required>{evaluaciones.length === 0 && <option value="">No hay evaluaciones por indicadores</option>}
              {evaluaciones.map((e) => <option value={e.id}>{e.seccion} · {e.periodo} · {e.nombre}</option>)}</select></label>
          )}
          <button>Ver informe</button>
        </div>
      </form>
    ))}
  </div>
  <style>.grid-inf { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr)); gap: 14px; } .grid-inf .tarjeta { margin: 0; }</style>
  <script is:inline>
    // El selector de estudiante muestra solo los de la sección elegida
    document.querySelectorAll('.grid-inf form').forEach((f) => {
      const s = f.querySelector('.sel-seccion'); if (!s) return;
      f.querySelectorAll('.sel-est, .sel-sec-dep').forEach((e) => {
        const filtrar = () => { e.value = ''; e.querySelectorAll('option[data-sec]').forEach((o) => { o.hidden = o.dataset.sec !== s.value; }); };
        s.addEventListener('change', filtrar); filtrar();
      });
    });
  </script>
</Base>
