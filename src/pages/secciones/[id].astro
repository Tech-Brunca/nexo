---
import Base from '../../layouts/Base.astro';
import { exec, q, one } from '../../lib/db';
import { estudiantesDe, seccion, seccionDuplicada, leccionesEfectivas } from '../../lib/calc';
import { num, numOrNull, str, parseCsv, etiquetaSeccion, validarSubgrupo } from '../../lib/util';
import { leerExcel, CEDULA_EJEMPLO } from '../../lib/excel';
const { user, inst } = Astro.locals;
const id = Number(Astro.params.id);
const sec = await seccion(user.id, id);
if (!sec) return Astro.redirect('/secciones');
let msg = '', error = '';

async function guardarEstudiante(d: Record<string, string>, subgrupo = '') {
  const ced = (d.cedula || '').replace(/[-–\s]/g, '');
  if (!ced || !d.apellidos || !d.nombre) return false;
  const fecha = (d.fecha_nac || '').trim();
  let fn: string | null = /^\d{4}-\d{2}-\d{2}$/.test(fecha) ? fecha
    : /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.test(fecha) ? fecha.replace(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/, (_, a, b, c) => `${c}-${b.padStart(2, '0')}-${a.padStart(2, '0')}`) : null;
  if (fn && Number.isNaN(new Date(fn + 'T00:00:00').getTime())) fn = null; // fecha imposible: se ignora
  await exec(
    `INSERT INTO {S}.estudiantes (usuario_id, cedula, apellidos, nombre, fecha_nac, genero, encargado, telefono, extranjero)
     VALUES (?,?,?,?,?,?,?,?,?) ON CONFLICT (usuario_id, cedula) DO UPDATE SET apellidos=EXCLUDED.apellidos, nombre=EXCLUDED.nombre,
     fecha_nac=COALESCE(EXCLUDED.fecha_nac, {S}.estudiantes.fecha_nac), genero=COALESCE(EXCLUDED.genero, {S}.estudiantes.genero),
     encargado=EXCLUDED.encargado, telefono=EXCLUDED.telefono, activo=1`,
    [user.id, ced, d.apellidos.trim(), d.nombre.trim(), fn, (d.genero || '').trim().slice(0, 1).toUpperCase() || null,
     (d.encargado || '').trim(), (d.telefono || '').trim(), /^(s|si|sí|1|x)$/i.test(d.extranjero || '') ? 1 : 0]);
  const e = await one<any>('SELECT id FROM {S}.estudiantes WHERE usuario_id=? AND cedula=?', [user.id, ced]);
  await exec('INSERT INTO {S}.matriculas (estudiante_id, seccion_id, subgrupo) VALUES (?,?,?) ON CONFLICT (estudiante_id, seccion_id) DO UPDATE SET subgrupo=EXCLUDED.subgrupo',
    [e.id, id, subgrupo.trim().toUpperCase().slice(0, 5)]);
  return true;
}

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = str(f.get('accion'));
  if (accion === 'agregar') {
    const d: any = {}; for (const k of ['cedula', 'apellidos', 'nombre', 'fecha_nac', 'genero', 'encargado', 'telefono']) d[k] = str(f.get(k));
    (await guardarEstudiante(d, str(f.get('subgrupo')))) ? (msg = 'Estudiante agregado.') : (error = 'Cédula, apellidos y nombre son obligatorios.');
  } else if (accion === 'importar') {
    const archivo = f.get('archivo');
    const ext = archivo instanceof File ? (archivo.name.split('.').pop() ?? '').toLowerCase() : '';
    if (ext === 'xls') error = 'El formato .xls (Excel 97-2003) no se puede leer. En Excel use «Guardar como» → «Libro de Excel (.xlsx)».';
    else if (archivo instanceof File && archivo.size) {
      const filas = ext === 'xlsx' ? await leerExcel(await archivo.arrayBuffer()) : parseCsv(await archivo.text());
      const norm = (c: string) => c.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      // La cabecera puede venir debajo de filas de título (nombre del colegio, fecha…)
      const h = filas.findIndex((r) => r.some((c) => norm(c).startsWith('cedula')));
      const cab = h >= 0 ? filas[h].map(norm) : [];
      const col = (n: string) => cab.findIndex((c) => c.startsWith(n));
      const idx = { cedula: col('cedula'), apellidos: col('apellido'), apellido1: col('primer apellido'), apellido2: col('segundo apellido'), nombre: col('nombre'),
        seccion: col('seccion'), fecha_nac: col('fecha'), genero: col('genero'), encargado: col('encargad'), telefono: col('telefono'), extranjero: col('extranjer'), subgrupo: col('subgrupo') };
      if (idx.cedula < 0 || (idx.apellidos < 0 && idx.apellido1 < 0) || idx.nombre < 0) error = 'El archivo debe tener columnas Cédula, Primer apellido, Segundo apellido y Nombre. Descargue la plantilla.';
      else {
        const clave = (v: string) => v.replace(/\s/g, '').split(/[-–]/).map((p) => p.replace(/^0+(?=.)/, '').toUpperCase()).join('-');
        // Un medio grupo (7-1A) recibe las filas de su sección completa (7-1)
        const estas = [clave(etiquetaSeccion({ ...sec, subgrupo: null })), clave(etiquetaSeccion(sec))];
        let n = 0, malas = 0, otras = 0;
        for (const r of filas.slice(h + 1)) {
          const d: any = {}; for (const [k, i] of Object.entries(idx)) d[k] = i >= 0 ? r[i] ?? '' : '';
          if (idx.apellidos < 0) d.apellidos = `${d.apellido1.trim()} ${d.apellido2.trim()}`.trim();
          if (d.cedula.replace(/[-–\s]/g, '') === CEDULA_EJEMPLO) continue; // fila de ejemplo de la plantilla
          if (d.seccion.trim() && !estas.includes(clave(d.seccion))) { otras++; continue; }
          try { if (await guardarEstudiante(d, d.subgrupo)) n++; else malas++; } catch { malas++; }
        }
        msg = `${n} estudiantes importados o actualizados.` + (malas ? ` ${malas} fila(s) omitidas por datos incompletos.` : '')
          + (otras ? ` ${otras} fila(s) de otras secciones no se importaron aquí.` : '');
      }
    } else error = 'Elija un archivo de Excel (.xlsx) o CSV.';
  } else if (accion === 'quitar') {
    await exec('DELETE FROM {S}.matriculas WHERE estudiante_id=? AND seccion_id=?', [num(f.get('estudiante_id')), id]);
  } else if (accion === 'subgrupo') {
    await exec('UPDATE {S}.matriculas SET subgrupo=? WHERE estudiante_id=? AND seccion_id=?', [str(f.get('subgrupo')).toUpperCase().slice(0, 5), num(f.get('estudiante_id')), id]);
  } else if (accion === 'datos') {
    const nivel = str(f.get('nivel')), nombre = str(f.get('nombre'));
    const sg = validarSubgrupo(nivel, str(f.get('subgrupo')));
    const asg = numOrNull(f.get('asignatura_id'));
    const propia = asg && (await q('SELECT id FROM general.asignaturas WHERE id=? AND usuario_id=?', [asg, user.id])).length ? asg : null;
    const datos = { nivel, nombre, subgrupo: sg.subgrupo, asignatura_id: propia, anio: sec.anio };
    if (!nivel || !nombre) error = 'Indique nivel y nombre.';
    else if (sg.error) error = sg.error;
    else if (await seccionDuplicada(user.id, datos, id)) error = `Ya existe la sección ${etiquetaSeccion(datos)} con esa asignatura en el curso ${sec.anio}.`;
    else {
      await exec('UPDATE {S}.secciones SET nivel=?, nombre=?, subgrupo=?, asignatura_id=?, nota_aprobatoria=? WHERE id=? AND usuario_id=?',
        [nivel, nombre, sg.subgrupo, propia, numOrNull(f.get('nota_aprobatoria')), id, user.id]);
      return Astro.redirect(`/secciones/${id}`);
    }
  } else if (accion === 'lecciones') {
    // Total de lecciones impartidas por periodo: se guarda como corrección sobre la suma de los días
    // registrados en Asistencia; vacío = sin corrección
    const mios = await q<any>('SELECT * FROM {S}.periodos WHERE usuario_id=?', [user.id]);
    const valores = mios.filter((p) => f.has(`lec_${p.id}`)).map((p) => [p, str(f.get(`lec_${p.id}`))] as const);
    if (valores.some(([, v]) => v !== '' && !/^\d{1,4}$/.test(v))) error = 'Las lecciones impartidas deben ser números enteros mayores o iguales a 0.';
    else {
      for (const [per, v] of valores)
        if (v === '') await exec('DELETE FROM {S}.lecciones WHERE seccion_id=? AND periodo_id=?', [id, per.id]);
        else await exec('INSERT INTO {S}.lecciones (seccion_id, periodo_id, ajuste) VALUES (?,?,?) ON CONFLICT (seccion_id, periodo_id) DO UPDATE SET ajuste=EXCLUDED.ajuste',
          [id, per.id, Number(v) - (await leccionesEfectivas(id, per)).calculado]);
      msg = 'Lecciones guardadas.';
    }
  }
}
const ests = await estudiantesDe(id);
const asignaturas = await q<any>('SELECT * FROM general.asignaturas WHERE usuario_id=? ORDER BY nombre', [user.id]);
const periodos = await q<any>(`SELECT p.*, l.cantidad FROM {S}.periodos p LEFT JOIN {S}.lecciones l ON l.periodo_id=p.id AND l.seccion_id=?
  WHERE p.usuario_id=? ORDER BY numero`, [id, user.id]);
for (const p of periodos) p.total = (await leccionesEfectivas(id, p)).efectivas;
const edad = (f: string | null) => f ? Math.floor((Date.now() - new Date(f).getTime()) / 31557600000) : '';
---
<Base titulo={`Sección ${etiquetaSeccion(sec)}`}>
  <p class="no-print"><a href="/secciones">← Secciones</a></p>
  <h1>Sección {etiquetaSeccion(sec)}</h1>
  <p class="sub">{sec.asignatura ?? 'Sin asignatura'} · {ests.length} estudiantes · Curso {sec.anio}</p>
  {msg && <div class="msg ok">{msg}</div>}{error && <div class="msg mal">{error}</div>}

  <details class="tarjeta no-print"><summary><b>Datos de la sección y lecciones efectivas</b></summary>
    <form method="post" class="fila" style="margin-top:12px">
      <input type="hidden" name="accion" value="datos" />
      <label>Nivel<input name="nivel" id="nivel" value={sec.nivel} size="4" /></label>
      <label>Sección<input name="nombre" value={sec.nombre} size="6" /></label>
      <label>Subgrupo
        <select name="subgrupo" id="subgrupo"><option value="">Sin subgrupo</option>{['A', 'B'].map((g) => <option selected={sec.subgrupo === g}>{g}</option>)}</select>
      </label>
      <label>Asignatura<select name="asignatura_id"><option value="">—</option>{asignaturas.map((a) => <option value={a.id} selected={a.id === sec.asignatura_id}>{a.nombre}</option>)}</select></label>
      <label>Nota aprobatoria<input name="nota_aprobatoria" value={sec.nota_aprobatoria ?? ''} size="5" /></label>
      <button class="sec">Guardar</button>
    </form>
    <script is:inline>
      // El subgrupo (medio grupo de taller) solo aplica en 7.°, 8.° y 9.°
      const nv = document.getElementById('nivel'), sg = document.getElementById('subgrupo');
      const upd = () => { const ok = ['7', '8', '9'].includes(nv.value.trim()); sg.disabled = !ok; if (!ok) sg.value = ''; };
      nv.oninput = upd; upd();
    </script>
    <form method="post" class="fila" style="margin-top:12px">
      <input type="hidden" name="accion" value="lecciones" />
      {periodos.map((p) => <label>Lecciones impartidas {p.nombre}<input type="number" name={`lec_${p.id}`} value={p.total} min="0" max="9999" step="1" style="width:130px" /></label>)}
      <button class="sec">Guardar lecciones</button>
      <span class="muted">Base del % de ausentismo. Se suman solas con las «Lecciones de hoy» de Asistencia; aquí puede corregir el total.</span>
    </form>
  </details>

  <div class="tarjeta no-print">
    <form method="post" class="fila">
      <input type="hidden" name="accion" value="agregar" />
      <label>Cédula<input name="cedula" required size="12" /></label>
      <label>Apellidos<input name="apellidos" required /></label>
      <label>Nombre<input name="nombre" required /></label>
      <label>Nacimiento<input type="date" name="fecha_nac" /></label>
      <label>Género<select name="genero"><option value="">—</option><option>F</option><option>M</option></select></label>
      <label>Encargado(a)<input name="encargado" /></label>
      <label>Teléfono<input name="telefono" size="10" /></label>
      <label>Subgrupo<input name="subgrupo" size="3" /></label>
      <button>Agregar</button>
    </form>
    <form method="post" enctype="multipart/form-data" class="fila" style="margin-top:12px">
      <input type="hidden" name="accion" value="importar" />
      <label>Importar lista (Excel o CSV)<input type="file" name="archivo" accept=".xlsx,.csv,text/csv" /></label>
      <button class="sec">Importar</button>
      <a href="/plantilla-estudiantes.xlsx">Descargar plantilla</a>
      <span class="muted">Llene la plantilla de Excel desde la fila 6 y súbala tal cual (.xlsx). Solo se importan las filas de esta sección (o sin sección). Si la cédula ya existe, se actualizan sus datos.</span>
    </form>
  </div>

  <div class="tabla"><table>
    <tr><th>#</th><th>Cédula</th><th>Estudiante</th><th class="n">Edad</th><th>Encargado(a)</th><th>Teléfono</th><th>Subgrupo</th><th class="no-print"></th></tr>
    {ests.map((e, i) => (
      <tr><td>{i + 1}</td><td>{e.cedula}</td><td class="nom">{e.apellidos} {e.nombre}</td><td class="n">{edad(e.fecha_nac)}</td><td>{e.encargado}</td><td>{e.telefono}</td>
        <td><form method="post" class="no-print" style="display:flex;gap:4px"><input type="hidden" name="accion" value="subgrupo" /><input type="hidden" name="estudiante_id" value={e.id} /><input name="subgrupo" value={e.subgrupo} style="width:50px" onchange="this.form.submit()" /></form><span class="solo-print">{e.subgrupo}</span></td>
        <td class="no-print" style="text-align:right"><form method="post" onsubmit="return confirm('¿Quitar de la sección?')"><input type="hidden" name="accion" value="quitar" /><input type="hidden" name="estudiante_id" value={e.id} /><button class="mini peligro">Quitar</button></form></td></tr>
    ))}
  </table></div>
  <p class="no-print"><button class="sec" onclick="print()">Imprimir lista</button></p>
</Base>
