---
// Importar y exportar con la plantilla del SEA: "Id";"Nombre";"Trabajo cotidiano";"Tareas";"Prueba";"Proyecto";"Asistencia"
import Base from '../layouts/Base.astro';
import Selector from '../components/Selector.astro';
import { q, one, exec, transaccion, preparar, esquemaActual } from '../lib/db';
import { seccion, calcularPeriodo, periodoDeFecha } from '../lib/calc';
import { str, fmt, parseCsv, etiquetaSeccion } from '../lib/util';
import { SEA, COLUMNAS_SEA, normalizar, numSea, leerNum, separarNombre, asegurarComponentes, guardarNotasSea, valorPrueba1, type NotaSea } from '../lib/sea';
const { user } = Astro.locals;
const U = user.id;
const seccionId = Number(Astro.url.searchParams.get('seccion') ?? 0);
const periodos = await q<any>('SELECT id, numero, nombre, fecha_ini, fecha_fin FROM {S}.periodos WHERE usuario_id=? ORDER BY numero', [U]);
const pedido = Number(Astro.url.searchParams.get('periodo') ?? 0);
const per = periodos.find((p) => p.id === pedido) ?? periodos.find((p) => p.id === Astro.locals.periodo?.id) ?? periodoDeFecha(periodos);
const sec = seccionId ? await seccion(U, seccionId) : null;
if (sec) await asegurarComponentes(U, sec.nivel, sec.asignatura_id);
const comps = sec ? await q<any>('SELECT * FROM {S}.componentes WHERE usuario_id=? AND nivel=? AND COALESCE(asignatura_id,0)=? AND clave IS NOT NULL', [U, sec.nivel, sec.asignatura_id ?? 0]) : [];
const compDe = (k: string) => comps.find((c) => c.clave === k);
const ORD = ['primer', 'segundo', 'tercer', 'cuarto'];
const nombreArchivo = () => `sea_${ORD[(per?.numero ?? 1) - 1] ?? 'periodo' + per?.numero}_periodo_${etiquetaSeccion(sec)}.csv`;

// ── Exportar ───────────────────────────────────────────────────────────────
if (sec && per && Astro.url.searchParams.get('exportar')) {
  const r = (await calcularPeriodo(U, sec.id, per.id))!;
  const enteros = Astro.url.searchParams.get('decimales') !== '2';
  const v = (n: number) => numSea(enteros ? Math.round(n) : Math.round(n * 100) / 100);
  const filas = [COLUMNAS_SEA, ...r.filas.map((f) => [f.est.cedula, `${f.est.apellidos} ${f.est.nombre}`,
    ...SEA.map((s) => { const c = r.comps.find((x) => x.clave === s.clave); return c ? v(f.porComp[c.id] ?? 0) : '0'; })])];
  const texto = '﻿' + filas.map((fila) => fila.map((x) => `"${String(x).replace(/"/g, '""')}"`).join(';')).join('\n') + '\n';
  return new Response(texto, { headers: { 'Content-Type': 'text/csv; charset=utf-8', 'Content-Disposition': `attachment; filename="${nombreArchivo()}"` } });
}

// Evaluaciones creadas directamente en Nexo en esta sección y periodo (no vienen del SEA)
const directas = async () => sec && per ? await q<any>(`SELECT e.id, e.nombre, c.nombre AS componente,
    (SELECT COUNT(*) FROM {S}.notas n WHERE n.evaluacion_id=e.id AND (n.puntos IS NOT NULL OR n.no_entrego))
    + (SELECT COUNT(DISTINCT v.estudiante_id) FROM {S}.valoraciones v WHERE v.evaluacion_id=e.id AND v.nivel IS NOT NULL) AS calificados
  FROM {S}.evaluaciones e JOIN {S}.componentes c ON c.id=e.componente_id
  WHERE e.seccion_id=? AND e.periodo_id=? AND e.origen IS NULL ORDER BY c.orden, e.fecha NULLS LAST, e.id`, [sec.id, per.id]) : [];

// ── Importar ───────────────────────────────────────────────────────────────
let msg = '', errores: string[] = [];
if (sec && per && Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = str(f.get('accion'));
  if (accion === 'quitar') {
    await exec('DELETE FROM {S}.notas_importadas WHERE seccion_id=? AND periodo_id=?', [sec.id, per.id]);
    // Las evaluaciones del SEA y la II prueba creada sola (si nadie la calificó)
    await exec(`DELETE FROM {S}.evaluaciones e WHERE e.seccion_id=? AND e.periodo_id=? AND (e.origen='sea' OR (e.origen='auto'
      AND NOT EXISTS (SELECT 1 FROM {S}.notas n WHERE n.evaluacion_id=e.id AND (n.puntos IS NOT NULL OR n.no_entrego))))`, [sec.id, per.id]);
    msg = `Se quitaron las calificaciones importadas de ${per.nombre}.`;
  } else if (accion === 'importar') {
    const archivo = f.get('archivo');
    const conNotas = str(f.get('modo')) !== 'estudiantes';
    // II periodo: la Prueba del archivo es solo la I prueba (se puede cambiar en el formulario)
    // Qué hacer con las evaluaciones creadas en Nexo: 'conservar' o 'eliminar' (se pregunta si hay alguna)
    const conExistentes = str(f.get('existentes'));
    const previas = conNotas ? await directas() : [];
    if (previas.length && !['conservar', 'eliminar'].includes(conExistentes))
      errores.push('Indique qué hacer con las evaluaciones creadas en Nexo en este periodo.');
    const soloPrimera = (str(f.get('prueba')) || (per.numero === 2 ? 'primera' : 'ambas')) === 'primera';
    if (!(archivo instanceof File) || !archivo.size) errores.push('Elija el archivo .csv.');
    else if (/\.xlsx?$/i.test(archivo.name)) errores.push('El archivo es de Excel (.xlsx). En Excel use Archivo → Guardar como → «CSV UTF-8 (delimitado por comas)» y súbalo de nuevo.');
    else {
      const filas = parseCsv(await archivo.text());
      const enc = (filas[0] ?? []).map((x) => x.trim());
      // Igual que ReDDi: las columnas deben ser exactamente las de la plantilla, en el mismo orden
      if (enc.length < COLUMNAS_SEA.length || COLUMNAS_SEA.some((c, i) => normalizar(enc[i] ?? '') !== normalizar(c))) {
        errores.push(`Las columnas no coinciden con la plantilla del SEA. Se esperaba: ${COLUMNAS_SEA.join(' · ')}. El archivo tiene: ${enc.join(' · ') || '(vacío)'}.`);
      } else {
        const datos: { cedula: string; nombre: string; vals: (number | null)[] }[] = [];
        const vistas = new Set<string>();
        filas.slice(1).forEach((fila, i) => {
          const n = i + 2;
          const cedula = (fila[0] ?? '').trim().replace(/\s/g, ''), nombre = (fila[1] ?? '').trim();
          if (!cedula && !nombre) return;
          if (!cedula || !nombre) { errores.push(`Fila ${n}: falta el Id o el Nombre.`); return; }
          if (vistas.has(cedula)) { errores.push(`Fila ${n}: el Id ${cedula} está repetido.`); return; }
          vistas.add(cedula);
          const vals = SEA.map((s, k) => {
            const x = leerNum(fila[k + 2] ?? '');
            const c = compDe(s.clave)!;
            if (x !== null && Number.isNaN(x)) errores.push(`Fila ${n} (${nombre}): «${fila[k + 2]}» en ${s.nombre} no es un número.`);
            else if (x !== null && (x < 0 || x > Number(c.porcentaje) + 0.001)) errores.push(`Fila ${n} (${nombre}): ${s.nombre} = ${x}, pero ese componente vale ${Number(c.porcentaje)}% en el nivel ${sec.nivel}. Revise los porcentajes en Componentes.`);
            return x;
          });
          datos.push({ cedula, nombre, vals });
        });
        if (!datos.length && !errores.length) errores.push('El archivo no tiene estudiantes.');
        const iP = SEA.findIndex((s) => s.clave === 'prueba');
        const p1 = soloPrimera ? valorPrueba1(compDe('prueba')) : null;
        if (conNotas && soloPrimera && p1 === null)
          errores.push(`No se puede tomar la Prueba como solo la I prueba: revise en Componentes (nivel ${sec.nivel}) cuánto vale la I prueba del II periodo.`);
        else if (conNotas && p1 !== null) datos.forEach((d, i) => {
          if ((d.vals[iP] ?? 0) > p1) errores.push(`Fila ${i + 2} (${d.nombre}): Prueba = ${d.vals[iP]}, pero la I prueba vale ${p1} % en el nivel ${sec.nivel}. Revise el valor en Componentes o elija «las dos pruebas».`);
        });
        if (!errores.length) {
          const esquema = esquemaActual();
          let nuevos = 0, matriculados = 0, notas = 0, creadas: string[] = [];
          const notasSea: NotaSea[] = [];
          await transaccion(async (c) => {
            const x = (sql: string, p: unknown[] = []) => c.query(preparar(sql, esquema), p);
            for (const d of datos) {
              let est = (await x('SELECT id FROM {S}.estudiantes WHERE usuario_id=? AND cedula=?', [U, d.cedula])).rows[0];
              if (!est) {
                const { apellidos, nombre } = separarNombre(d.nombre);
                est = (await x('INSERT INTO {S}.estudiantes (usuario_id, cedula, apellidos, nombre) VALUES (?,?,?,?) RETURNING id', [U, d.cedula, apellidos, nombre])).rows[0];
                nuevos++;
              }
              const m = await x('INSERT INTO {S}.matriculas (estudiante_id, seccion_id) VALUES (?,?) ON CONFLICT DO NOTHING', [est.id, sec.id]);
              matriculados += m.rowCount ?? 0;
              if (conNotas) for (const [k, s] of SEA.entries()) {
                if (d.vals[k] === null) continue;
                notas++;
                // Asistencia se guarda como valor del componente; lo demás, como evaluaciones (abajo)
                if (s.clave === 'asistencia')
                  await x(`INSERT INTO {S}.notas_importadas (estudiante_id, seccion_id, periodo_id, clave, valor) VALUES (?,?,?,?,?)
                    ON CONFLICT (estudiante_id, seccion_id, periodo_id, clave) DO UPDATE SET valor=EXCLUDED.valor, creado=now()`, [est.id, sec.id, per.id, s.clave, d.vals[k]]);
                else notasSea.push({ estudiante_id: est.id, clave: s.clave, valor: d.vals[k]! });
              }
            }
            if (conNotas && conExistentes === 'eliminar' && previas.length) {
              await x(`DELETE FROM {S}.evaluaciones WHERE seccion_id=? AND periodo_id=? AND origen IS NULL`, [sec.id, per.id]);
              creadas.push(previas.length === 1 ? 'se eliminó la evaluación creada en Nexo' : `se eliminaron ${previas.length} evaluaciones creadas en Nexo`);
            }
            if (notasSea.length)
              creadas = [...creadas, ...await guardarNotasSea(async (sql, p = []) => (await x(sql, p)).rows, U, sec, per.id, notasSea, soloPrimera)];
          });
          msg = `Archivo importado: ${datos.length} estudiantes (${nuevos} nuevos, ${matriculados} agregados a ${etiquetaSeccion(sec)})` +
            (conNotas ? `, ${notas} calificaciones de ${per.nombre}.` : '. No se importaron calificaciones.') +
            (creadas.length ? ` Evaluaciones: ${creadas.join(' · ')}.` : '');
        }
      }
    }
  }
}
const existentes = await directas();
const r = sec && per ? await calcularPeriodo(U, sec.id, per.id) : null;
const nImp = sec && per ? Number((await one<any>(`SELECT (SELECT COUNT(*) FROM {S}.notas_importadas WHERE seccion_id=? AND periodo_id=?)
  + (SELECT COUNT(*) FROM {S}.evaluaciones WHERE seccion_id=? AND periodo_id=? AND origen='sea') AS n`, [sec.id, per.id, sec.id, per.id])).n) : 0;
const sumaPct = comps.reduce((s, c) => s + Number(c.porcentaje), 0);
const qs = sec && per ? `seccion=${sec.id}&periodo=${per.id}` : '';
---
<Base titulo="SEA">
  <h1>Importar y exportar SEA</h1>
  <p class="sub">Con la plantilla del SEA: Id, Nombre, Trabajo cotidiano, Tareas, Prueba, Proyecto y Asistencia. Los valores son los puntos obtenidos de cada porcentaje.</p>
  <Selector seccionId={seccionId} periodoId={per?.id} conPeriodo />
  {msg && <div class="msg ok">{msg}</div>}
  {errores.length > 0 && <div class="msg mal"><b>No se importó nada.</b> Corrija el archivo e inténtelo de nuevo:<ul style="margin:6px 0 0;padding-left:20px">{errores.slice(0, 15).map((e) => <li>{e}</li>)}</ul>{errores.length > 15 && <p style="margin:6px 0 0">… y {errores.length - 15} más.</p>}</div>}
  {sec && per && r && (
    <>
      {sumaPct !== 100 && <div class="msg aviso">Los componentes del nivel {sec.nivel} suman {sumaPct}%. Ajústelos en <a href={`/componentes?nivel=${sec.nivel}&asignatura=${sec.asignatura_id ?? 0}`}>Componentes</a> antes de importar o exportar.</div>}
      <div class="grid-sea">
        <div class="tarjeta">
          <h2 style="margin-top:0">Exportar al SEA</h2>
          <p class="muted">Descarga {per.nombre} de {etiquetaSeccion(sec)} con las columnas de la plantilla, listo para subir al SEA.</p>
          <form method="get" class="fila">
            <input type="hidden" name="seccion" value={sec.id} /><input type="hidden" name="periodo" value={per.id} /><input type="hidden" name="exportar" value="1" />
            <label>Valores<select name="decimales"><option value="0">Enteros (como ReDDi)</option><option value="2">Con 2 decimales</option></select></label>
            <button>Exportar CSV</button>
          </form>
        </div>
        <form method="post" enctype="multipart/form-data" class="tarjeta" action={`/sea?${qs}`}>
          <h2 style="margin-top:0">Importar</h2>
          <p class="muted">Desde ReDDi o desde el SEA. Se revisa que las columnas sean exactamente las de la plantilla; si algo no calza, no se importa nada.</p>
          <input type="hidden" name="accion" value="importar" />
          <div class="fila">
            <label style="flex:2">Archivo .csv<input type="file" name="archivo" accept=".csv,text/csv" required /></label>
            <label style="flex:1">Qué importar<select name="modo"><option value="notas">Estudiantes y calificaciones de {per.nombre}</option><option value="estudiantes">Solo estudiantes</option></select></label>
          </div>
          <div class="fila" style="margin-top:10px">
            <label style="flex:2">La nota de Prueba del archivo es
              <select name="prueba">
                <option value="ambas" selected={per.numero !== 2}>La suma de las dos pruebas (todo el componente)</option>
                <option value="primera" selected={per.numero === 2}>Solo la I prueba{valorPrueba1(compDe('prueba')) !== null ? ` (vale ${valorPrueba1(compDe('prueba'))} %)` : ''}</option>
              </select></label>
            {existentes.length > 0 && (
              <label style="flex:2">Este periodo ya tiene {existentes.length === 1 ? 'una evaluación creada' : `${existentes.length} evaluaciones creadas`} en Nexo: {existentes.slice(0, 6).map((e) => `${e.nombre} (${e.componente}${Number(e.calificados) ? `, ${e.calificados} con nota` : ''})`).join(', ')}{existentes.length > 6 ? '…' : ''}. {existentes.length === 1 ? '¿Qué hacer con ella?' : '¿Qué hacer con ellas?'}
                <select name="existentes" id="sel-existentes">
                  <option value="">— Elija —</option>
                  <option value="conservar">Conservarlas (si el componente viene completo del SEA, no cuentan)</option>
                  <option value="eliminar">Eliminarlas y dejar solo lo importado</option>
                </select></label>
            )}
            <button onclick="const s=document.getElementById('sel-existentes'); return !s || s.value!=='eliminar' || confirm('Se eliminarán las evaluaciones creadas en Nexo en este periodo, con sus notas. ¿Continuar?')">Importar</button>
          </div>
          <p class="muted" style="margin:8px 0 0">Las notas quedan como evaluaciones «(SEA)» en Evaluaciones. En el II periodo la Prueba es solo la I prueba (su valor se configura en Componentes) y se crea la II prueba sin calificar.</p>
        </form>
      </div>
      <h2>{per.nombre} · {etiquetaSeccion(sec)} <span class="muted" style="font-weight:400">({r.filas.length} estudiantes)</span></h2>
      {nImp > 0 && (
        <div class="msg aviso fila" style="justify-content:space-between;align-items:center">
          <span>Hay calificaciones importadas en este periodo: evaluaciones «(SEA)» y, si venía, la asistencia (marcada con <b>•</b>).</span>
          <form method="post" action={`/sea?${qs}`} onsubmit="return confirm('¿Quitar las calificaciones importadas de este periodo?')"><input type="hidden" name="accion" value="quitar" /><button class="mini peligro">Quitar importadas</button></form>
        </div>
      )}
      <div class="tabla"><table>
        <tr><th>Id</th><th>Nombre</th>{SEA.map((s) => <th class="n">{s.nombre}<br /><span style="font-weight:400">{Number(compDe(s.clave)?.porcentaje ?? 0)}%</span></th>)}<th class="n">Total</th></tr>
        {r.filas.map((f) => (
          <tr><td>{f.est.cedula}</td><td class="nom">{f.est.apellidos} {f.est.nombre}</td>
            {SEA.map((s) => { const c = r.comps.find((x) => x.clave === s.clave); return <td class="n">{c ? fmt(f.porComp[c.id]) : '—'}{c && f.importado[c.id] && <b title="Importado" style="color:var(--teal)"> •</b>}</td>; })}
            <td class="n"><b>{fmt(f.total)}</b></td></tr>
        ))}
        {r.filas.length === 0 && <tr><td colspan="8" class="muted">Sin estudiantes. Importe el archivo para agregarlos.</td></tr>}
      </table></div>
    </>
  )}
  <style>.grid-sea { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 14px; } .grid-sea .tarjeta { margin: 0; }</style>
</Base>
