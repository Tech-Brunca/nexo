---
import Base from '../layouts/Base.astro';
import { exec, q, one, prepararColegio } from '../lib/db';
import { hashClave, verificarClave, claveValida, COOKIE_INST } from '../lib/auth';
import { num, str } from '../lib/util';
const { user } = Astro.locals;
let msg = '', error = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = str(f.get('accion'));
  if (accion === 'perfil') {
    if (!str(f.get('nombre'))) error = 'El nombre es obligatorio.';
    else { await exec('UPDATE general.usuarios SET nombre=?, cedula=? WHERE id=?', [str(f.get('nombre')), str(f.get('cedula')), user.id]); msg = 'Datos guardados.'; }
  } else if (accion === 'clave') {
    const u = await one<any>('SELECT pass_hash FROM general.usuarios WHERE id=?', [user.id]);
    const nueva = str(f.get('nueva'));
    if (!(await verificarClave(str(f.get('actual')), u.pass_hash))) error = 'La contraseña actual no es correcta.';
    else if (!claveValida(nueva)) error = 'La nueva contraseña debe tener al menos 8 caracteres.';
    else if (nueva !== str(f.get('nueva2'))) error = 'Las contraseñas nuevas no coinciden.';
    else { await exec('UPDATE general.usuarios SET pass_hash=? WHERE id=?', [await hashClave(nueva), user.id]); msg = 'Contraseña cambiada.'; }
  } else if (accion === 'unirse') {
    const col = await one<any>('SELECT id, esquema FROM general.colegios WHERE id=? AND esquema IS NOT NULL', [num(f.get('colegio_id'))]);
    if (col) {
      await exec('INSERT INTO general.usuario_colegios VALUES (?,?) ON CONFLICT DO NOTHING', [user.id, col.id]);
      await prepararColegio(user.id, col.esquema);
      Astro.cookies.set(COOKIE_INST, String(col.id), { path: '/', httpOnly: true, sameSite: 'lax', maxAge: 365 * 86400 });
      return Astro.redirect('/cuenta?ok=1');
    }
  } else if (accion === 'salir-col') {
    const col = await one<any>(`SELECT c.esquema FROM general.colegios c JOIN general.usuario_colegios uc ON uc.colegio_id=c.id WHERE c.id=? AND uc.usuario_id=?`, [num(f.get('colegio_id')), user.id]);
    if (col) {
      const hay = await one<any>(`SELECT COUNT(*) AS n FROM ${col.esquema}.secciones WHERE usuario_id=?`, [user.id]);
      if (hay.n > 0) error = 'Tiene secciones en ese colegio. Elimínelas primero (descargue antes un respaldo).';
      else { await exec('DELETE FROM general.usuario_colegios WHERE usuario_id=? AND colegio_id=?', [user.id, num(f.get('colegio_id'))]); return Astro.redirect('/cuenta'); }
    }
  }
}
if (Astro.url.searchParams.get('ok')) msg = 'Colegio agregado y seleccionado.';
const datos = (await one<any>('SELECT nombre, correo, cedula FROM general.usuarios WHERE id=?', [user.id]))!;
const mios = await q<any>(`SELECT c.* FROM general.colegios c JOIN general.usuario_colegios uc ON uc.colegio_id=c.id
  WHERE uc.usuario_id=? ORDER BY c.nombre`, [user.id]);
for (const c of mios) c.secciones = c.esquema ? (await one<any>(`SELECT COUNT(*) AS n FROM ${c.esquema}.secciones WHERE usuario_id=?`, [user.id])).n : 0;
const otros = await q<any>(`SELECT * FROM general.colegios WHERE esquema IS NOT NULL
  AND id NOT IN (SELECT colegio_id FROM general.usuario_colegios WHERE usuario_id=?) ORDER BY nombre`, [user.id]);
---
<Base titulo="Mi cuenta">
  <h1>Mi cuenta</h1>
  <p class="sub">{datos.correo}</p>
  {mios.length === 0 && <div class="msg aviso">Para empezar, agregue el colegio (o colegios) donde trabaja.</div>}
  {msg && <div class="msg ok">{msg}</div>}{error && <div class="msg mal">{error}</div>}

  <div class="tarjeta">
    <h2 style="margin-top:0">Mis colegios</h2>
    {mios.length === 0 ? <p class="muted">Aún no tiene colegios.</p> : (
      <div class="tabla"><table>
        <tr><th>Colegio</th><th>Código</th><th>Regional</th><th class="n">Mis secciones</th><th></th></tr>
        {mios.map((i) => (
          <tr><td><b>{i.nombre}</b></td><td>{i.codigo}</td><td>{i.direccion_regional}</td><td class="n">{i.secciones}</td>
            <td style="text-align:right"><form method="post" onsubmit="return confirm('¿Quitar este colegio de su cuenta?')"><input type="hidden" name="accion" value="salir-col" /><input type="hidden" name="colegio_id" value={i.id} /><button class="mini peligro">Quitar</button></form></td></tr>
        ))}
      </table></div>
    )}
    {otros.length > 0 ? (
      <form method="post" class="fila" style="margin-top:14px">
        <input type="hidden" name="accion" value="unirse" />
        <label style="flex:1">Agregar un colegio
          <select name="colegio_id">{otros.map((i) => <option value={i.id}>{i.nombre}{i.codigo ? ` (${i.codigo})` : ''}</option>)}</select>
        </label>
        <button>Agregar</button>
      </form>
    ) : <p class="muted" style="margin-top:12px">No hay más colegios disponibles.</p>}
    <p class="muted">¿Su colegio no aparece? Pida a un administrador que lo registre en Nexo.</p>
  </div>

  <form method="post" class="tarjeta fila">
    <input type="hidden" name="accion" value="perfil" />
    <label style="flex:1">Nombre<input name="nombre" value={datos.nombre} required /></label>
    <label>Cédula<input name="cedula" value={datos.cedula} /></label>
    <button class="sec">Guardar</button>
  </form>

  <form method="post" class="tarjeta fila">
    <input type="hidden" name="accion" value="clave" />
    <label>Contraseña actual<input type="password" name="actual" autocomplete="current-password" required /></label>
    <label>Nueva contraseña<input type="password" name="nueva" autocomplete="new-password" minlength="8" required /></label>
    <label>Repetir nueva<input type="password" name="nueva2" autocomplete="new-password" required /></label>
    <button class="sec">Cambiar contraseña</button>
  </form>
</Base>
