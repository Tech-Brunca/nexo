---
import Base from '../layouts/Base.astro';
import { COOKIE, COOKIE_INST, DURACION_H, nuevaSesion, verificarClave, esCorreoAdmin } from '../lib/auth';
import { one, exec } from '../lib/db';
import { str } from '../lib/util';
let error = '';
let correo = '';
const registrado = Astro.url.searchParams.get('registrado');
if (Astro.request.method === 'POST') {
  if (Astro.url.searchParams.get('salir')) {
    Astro.cookies.delete(COOKIE, { path: '/' });
    Astro.cookies.delete(COOKIE_INST, { path: '/' });
    return Astro.redirect('/login');
  }
  const f = await Astro.request.formData();
  correo = str(f.get('correo')).toLowerCase();
  const u = await one<any>('SELECT * FROM usuarios WHERE correo=?', [correo]);
  const ok = u ? await verificarClave(str(f.get('clave')), u.pass_hash) : false;
  if (!ok) {
    await new Promise((r) => setTimeout(r, 600)); // frena intentos repetidos
    error = 'Correo o contraseña incorrectos.';
  } else if (u.estado === 'pendiente' && !esCorreoAdmin(u.correo)) {
    error = 'Su cuenta está pendiente de aprobación. Le avisarán cuando esté activa.';
  } else if (u.estado === 'bloqueado') {
    error = 'Esta cuenta está desactivada. Consulte con el administrador.';
  } else {
    if (esCorreoAdmin(u.correo)) await exec(`UPDATE usuarios SET rol='admin', estado='activo' WHERE id=?`, [u.id]);
    await exec('UPDATE usuarios SET ultimo_acceso=NOW() WHERE id=?', [u.id]);
    Astro.cookies.set(COOKIE, nuevaSesion(u.id), { path: '/', httpOnly: true, sameSite: 'lax', secure: Astro.url.protocol === 'https:', maxAge: DURACION_H * 3600 });
    const r = Astro.url.searchParams.get('r') || '/';
    return Astro.redirect(r.startsWith('/') && !r.startsWith('//') ? r : '/');
  }
}
---
<Base titulo="Ingresar" sinMenu>
  <div style="min-height:100vh;display:grid;place-items:center;padding:20px">
    <form method="post" class="tarjeta" style="width:min(380px,100%);padding:28px">
      <h1>Nexo</h1>
      <p class="sub">Registro digital docente: asistencia, evaluaciones y calificaciones.</p>
      {registrado && <div class="msg ok">Solicitud enviada. Podrá ingresar cuando un administrador apruebe su cuenta.</div>}
      {error && <div class="msg mal">{error}</div>}
      <label>Correo<input type="email" name="correo" value={correo} autocomplete="username" autofocus required /></label>
      <label style="margin-top:10px">Contraseña<input type="password" name="clave" autocomplete="current-password" required /></label>
      <p><button style="width:100%">Ingresar</button></p>
      <p class="muted">¿No tiene cuenta? <a href="/registro">Solicitar acceso</a></p>
    </form>
  </div>
</Base>
