---
import Base from '../layouts/Base.astro';
import Selector from '../components/Selector.astro';
import EnviarWa from '../components/EnviarWa.astro';
import { q } from '../lib/db';
import { estudiantesDe, seccion } from '../lib/calc';
import { str, csv, etiquetaSeccion } from '../lib/util';
import { TIPOS, plantillas, llenar, enlaceWa } from '../lib/whatsapp';
const tipoTxt = (t: string) => TIPOS[t]?.titulo ?? (t === 'hogar' ? 'Comunicado al hogar' : t);
const MEDIO: Record<string, string> = { whatsapp: 'WhatsApp', impreso: 'Impreso', ambos: 'WhatsApp e impreso' };
const { user, inst } = Astro.locals;
const seccionId = Number(Astro.url.searchParams.get('seccion') ?? 0);
const sec = seccionId ? await seccion(user.id, seccionId) : null;
const pl = await plantillas(user.id);
const texto = Astro.url.searchParams.get('texto') ?? pl.libre;

let destinos: any[] = [];
if (sec) {
  const ests = await estudiantesDe(seccionId);
  destinos = ests.map((e) => {
    const mensaje = llenar(texto, { encargado: e.encargado, estudiante: `${e.nombre} ${e.apellidos}`, seccion: `${etiquetaSeccion(sec)}`,
      asignatura: sec.asignatura ?? '', docente: user.nombre, colegio: inst!.nombre });
    return { estudiante_id: e.id, nombre: `${e.apellidos} ${e.nombre}`, encargado: e.encargado, telefono: e.telefono, mensaje, enlace: enlaceWa(e.telefono, mensaje) };
  });
}
const historial = await q<any>(`SELECT c.*, to_char(c.creado AT TIME ZONE 'America/Costa_Rica', 'YYYY-MM-DD HH24:MI') AS creado, e.apellidos, e.nombre FROM {S}.comunicados c LEFT JOIN {S}.estudiantes e ON e.id=c.estudiante_id
  WHERE c.usuario_id=? ORDER BY c.creado DESC LIMIT 300`, [user.id]);
if (Astro.url.searchParams.get('csv')) {
  return new Response(csv([['Fecha', 'Tipo', 'Medio', 'Estudiante', 'Teléfono', 'Mensaje'],
    ...historial.map((h) => [h.creado, tipoTxt(h.tipo), MEDIO[h.medio] ?? h.medio, h.apellidos ? `${h.apellidos} ${h.nombre}` : '', h.telefono, h.mensaje])]),
    { headers: { 'Content-Type': 'text/csv; charset=utf-8', 'Content-Disposition': 'attachment; filename="comunicados.csv"' } });
}
const sinTel = destinos.filter((d) => !d.enlace).length;
// Para «Comunicado a un solo estudiante»: todos sus estudiantes activos, agrupados por sección
const todos = await q<any>(`SELECT e.id, e.apellidos, e.nombre, s.id AS sid, s.nivel, s.nombre AS snombre, s.subgrupo FROM {S}.matriculas m
  JOIN {S}.estudiantes e ON e.id=m.estudiante_id JOIN {S}.secciones s ON s.id=m.seccion_id
  WHERE s.usuario_id=? AND e.activo=1 ORDER BY length(s.nivel), s.nivel, s.nombre, s.subgrupo NULLS FIRST, e.apellidos, e.nombre`, [user.id]);
const grupos = new Map<number, { etiqueta: string; ests: any[] }>();
for (const r of todos) (grupos.get(r.sid) ?? grupos.set(r.sid, { etiqueta: etiquetaSeccion({ nivel: r.nivel, nombre: r.snombre, subgrupo: r.subgrupo }), ests: [] }).get(r.sid)!).ests.push(r);
---
<Base titulo="Comunicados">
  <h1>Comunicados</h1>
  <form class="tarjeta un-est" id="un-estudiante" onsubmit="event.preventDefault(); const v = this.est.value; if (v) location.href = '/estudiantes/' + v.split(':')[0] + '?seccion=' + v.split(':')[1] + '#hogar';">
    <h2 style="margin-top:0">A un solo estudiante</h2>
    <p class="muted">Abre su perfil con el «Comunicado al hogar»: plantilla, envío por WhatsApp o impreso para el cuaderno de comunicaciones. Queda en la bitácora.</p>
    <div class="fila">
      <label style="flex:1">Estudiante<select name="est" required onchange="this.form.requestSubmit()"><option value="">Elija un estudiante…</option>
        {[...grupos.entries()].map(([sid, g]) => <optgroup label={g.etiqueta}>{g.ests.map((e) => <option value={`${e.id}:${sid}`}>{e.apellidos} {e.nombre}</option>)}</optgroup>)}
      </select></label>
      <button>Abrir</button>
    </div>
  </form>
  <h2>A todo un grupo</h2>
  <p class="sub">Envíe un mensaje a los encargados de un grupo por WhatsApp. Los avisos de ausencia y de «no entregó» también aparecen en Asistencia y en cada evaluación.</p>
  <Selector seccionId={seccionId} />
  {sec && (
    <>
      <form method="get" class="tarjeta">
        <input type="hidden" name="seccion" value={seccionId} />
        <label>Mensaje para todo el grupo {etiquetaSeccion(sec)}
          <textarea name="texto" rows="4" style="width:100%">{texto}</textarea></label>
        <p class="fila"><button class="sec">Preparar mensajes</button> <span class="muted">Variables: {'{encargado} {estudiante} {seccion} {asignatura} {docente} {colegio}'} · <a href="/plantillas">Editar plantillas</a></span></p>
      </form>
      {sinTel > 0 && <div class="msg aviso">{sinTel} estudiante(s) no tienen teléfono del encargado. Agréguelo en <a href={`/secciones/${seccionId}`}>la sección</a> o en Estudiantes.</div>}
      <EnviarWa destinos={destinos} tipo="libre" referencia={`seccion:${seccionId}`} titulo="Destinatarios" seccion={seccionId} />
    </>
  )}
  <h2>Historial</h2>
  <div class="tabla"><table>
    <tr><th>Fecha</th><th>Tipo</th><th>Estudiante</th><th>Mensaje</th></tr>
    {historial.length === 0 && <tr><td colspan="4" class="muted">Aún no se han enviado comunicados.</td></tr>}
    {historial.map((h) => (
      <tr><td style="white-space:nowrap">{h.creado}</td><td>{tipoTxt(h.tipo)}<br /><span class="muted">{MEDIO[h.medio] ?? h.medio}</span></td><td>{h.apellidos ? <a href={`/estudiantes/${h.estudiante_id}`}>{h.apellidos} {h.nombre}</a> : '—'}<br /><span class="muted">{h.telefono}</span></td>
        <td class="muted" style="max-width:520px">{h.mensaje}</td></tr>
    ))}
  </table></div>
  {historial.length > 0 && <p><a class="btn sec" href="?csv=1">Exportar historial (CSV)</a></p>}
</Base>
